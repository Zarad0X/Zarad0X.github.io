// The slider runs 0–100%, but 100% is capped at half of the browser's full volume.
const MAX_GAIN = 0.5;
let si = 0, vol = parseFloat(store.get('hz-vol3')); if (!(vol >= 0 && vol <= 1)) vol = 0.08;
jbVol.value = vol; audio.volume = vol * MAX_GAIN;
const fmt = t => `${Math.floor(t/60)}:${String(Math.floor(t%60)).padStart(2,'0')}`;
const showSong = () => { const s = songs[si]; npText.innerHTML = `${s.t} <span>— ${s.a.replace(/ feat\..*/,'')}</span>`; };
jbList.innerHTML = songs.map((s,i) => `<li><button type="button" data-i="${i}"><span class="n">${String(i+1).padStart(2,'0')}</span><span>${s.t}<span class="a">${s.a}</span></span></button></li>`).join('');
function mark(){ jbList.querySelectorAll('button').forEach(b => b.setAttribute('aria-current', String(+b.dataset.i === si))); }
function fadeIn(){ audio.volume = 0; const t0 = performance.now(); const step = now => { const k = Math.min(1,(now-t0)/600); audio.volume = vol*MAX_GAIN*k; if (k < 1 && !audio.paused) requestAnimationFrame(step); }; requestAnimationFrame(step); }
function loadSong(i, play){
  si = i; showSong(); mark();
  const s = songs[i];
  audio.src = s.p; jbBar.style.width = '0'; jbTime.textContent = '0:00';
  jbOpen.href = `https://music.apple.com/hk/album/${s.slug}/${s.album}?i=${s.id}`;
  if (play) audio.play().then(fadeIn).catch(() => {});
}
let refreshed = false;
function refreshPreviews(){
  if (refreshed) return; refreshed = true;
  fetch(`https://itunes.apple.com/lookup?country=hk&id=${songs.map(s => s.id).join(',')}`)
    .then(r => r.json()).then(d => { (d.results || []).forEach(r => { const s = songs.find(x => x.id === String(r.trackId)); if (s && r.previewUrl) s.p = r.previewUrl; }); })
    .catch(() => {});
}
function setJukebox(open){
  jb.hidden = !open; np.setAttribute('aria-expanded', open);
  if (open){ refreshPreviews(); if (!audio.src) loadSong(si, false); else mark(); }
}
showSong();
np.onclick = () => setJukebox(jb.hidden);
$('#jbClose').onclick = () => { setJukebox(false); np.focus(); };
jbList.addEventListener('click', e => { const b = e.target.closest('button'); if (b) loadSong(+b.dataset.i, true); });
jbPlay.onclick = () => { if (!audio.src) loadSong(si, false); audio.paused ? audio.play().then(fadeIn).catch(() => {}) : audio.pause(); };
jbVol.oninput = () => { vol = +jbVol.value; audio.volume = vol * MAX_GAIN; store.set('hz-vol3', vol); };
jbProg.onclick = e => { if (!audio.duration) return; const r = jbProg.getBoundingClientRect(); audio.currentTime = (e.clientX - r.left)/r.width*audio.duration; };
audio.addEventListener('play', () => { np.classList.add('on'); jbPlay.textContent = '❚❚'; jbPlay.setAttribute('aria-label','Pause'); });
audio.addEventListener('pause', () => { np.classList.remove('on'); jbPlay.textContent = '▶'; jbPlay.setAttribute('aria-label','Play'); });
audio.addEventListener('timeupdate', () => { if (!audio.duration) return; const k = audio.currentTime/audio.duration; jbBar.style.width = (k*100)+'%'; jbProg.setAttribute('aria-valuenow', Math.round(k*100)); jbTime.textContent = fmt(audio.currentTime); });
audio.addEventListener('ended', () => loadSong((si+1) % songs.length, true));
addEventListener('keydown', e => { if (e.key === 'Escape' && !jb.hidden) setJukebox(false); });

/* ---------- inner voice ---------- */
const voice = $('#voice');
function showVoice(el){ const [who,txt] = el.dataset.voice.split('|'); voice.innerHTML = `<b>${who}</b>${txt}`;
  const r = el.getBoundingClientRect(); voice.classList.add('on');
  const vw = voice.offsetWidth, vh = voice.offsetHeight;
  voice.style.left = Math.max(12, Math.min(innerWidth - vw - 12, r.left)) + 'px';
  voice.style.top = (r.top - vh - 10 < 8 ? r.bottom + 10 : r.top - vh - 10) + 'px'; }
const hideVoice = () => voice.classList.remove('on');
document.addEventListener('pointerover', e => { const el = e.target.closest('[data-voice]'); el ? showVoice(el) : hideVoice(); });
document.addEventListener('focusin', e => { const el = e.target.closest('[data-voice]'); el ? showVoice(el) : hideVoice(); });
document.addEventListener('scroll', hideVoice, true);


/* ---------- 奶蛙 ---------- */
(() => {
  const peek = $('#naiwaRoof'), stage = $('#naiwaStage');
  const lines = ['嘿！哈！', 'You found me. Now go read the paper.', 'Horse stance first. PhD later.', '我只是一只路过的奶蛙。', "Don't tell the reviewers I was here."];
  let li = Math.floor(Math.random()*lines.length), timer = null, out = false;
  const say = () => { li = (li + 1) % lines.length; voice.innerHTML = `<b>奶蛙</b>${lines[li]}`; voice.style.bottom = (stage.offsetHeight + 16) + 'px'; voice.classList.add('on'); };
  function hide(){
    if (!out) return; out = false; clearTimeout(timer);
    const done = () => { stage.hidden = true; voice.classList.remove('on'); voice.style.bottom = ''; };
    if (reduced) return done();
    stage.animate([{transform:'none'},{transform:'translateY(-14%)',offset:.3},{transform:'translateY(110%)'}], {duration:450, easing:'cubic-bezier(.5,0,.75,0)'}).onfinish = done;
  }
  function show(){
    clearTimeout(timer);
    if (out){ say(); if (!reduced) stage.animate([{transform:'none'},{transform:'translateY(-10%) rotate(-4deg)'},{transform:'none'}], {duration:380, easing:'cubic-bezier(.34,1.56,.64,1)'}); }
    else {
      out = true; stage.hidden = false;
      if (!reduced) stage.animate([{transform:'translateY(110%)'},{transform:'translateY(-12%) rotate(3deg)',offset:.6},{transform:'none'}], {duration:620, easing:'cubic-bezier(.25,1,.5,1)'});
      say();
    }
    timer = setTimeout(hide, 3000);
  }
  if (peek){ peek.addEventListener('click', show); peek.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' '){ e.preventDefault(); show(); } }); }
  stage.addEventListener('click', show);
  let typed = '';
  addEventListener('keydown', e => {
    if (e.target.closest && e.target.closest('input,textarea')) return;
    if (e.key === 'Escape') return hide();
    if (e.key.length !== 1) return;
    typed = (typed + e.key.toLowerCase()).slice(-5);
    if (typed === 'naiwa') show();
  });
})();

/* ---------- cards: layout + spring physics ---------- */
const table = $('#table'), hint = $('.hint');
const cards = [...table.querySelectorAll('.card')].map((el,i) => ({
  el, i, tilt: el.querySelector('.tilt'), front: el.querySelector('.front'),
  x:0,y:0,vx:0,vy:0,r:0,vr:0,s:1,vs:0,hx:0,hy:0,hr:0,rx:0,ry:0,trx:0,try_:0,
  hover:false,drag:false,down:null,active:false,phase:Math.random()*6.28 }));
let cw = 180, ch = 310;

function layout(){
  const W = table.clientWidth, H = table.clientHeight;
  cw = W >= 1000 ? 196 : W >= 700 ? 160 : Math.max(108, Math.min(140, W*0.31));
  ch = cw*1.72; table.style.setProperty('--cw', cw+'px');
  const n = cards.length, mid = (n-1)/2;
  const spacing = Math.min(cw*1.14, (W - cw - 32)/(n-1));
  const fan = W < 700 ? 7 : 5;
  cards.forEach(c => {
    const d = c.i - mid;
    c.hx = W/2 + d*spacing - cw/2;
    c.hy = H*0.46 - ch/2 + d*d*(W<700?6:9) - (d===0?14:0);
    c.hr = d*fan;
    if (!c.hover && !c.drag) c.el.style.zIndex = d===0 ? 6 : 5 - Math.abs(d);
  });
  hint.style.top = (H*0.46 + ch/2 + (W<700?40:46)) + 'px';
}
layout(); addEventListener('resize', layout);

// deal from the deck (off-screen bottom-right)
cards.forEach(c => { c.x = table.clientWidth + 80; c.y = table.clientHeight + 120; c.r = 40; c.el.style.transform = `translate3d(${c.x}px,${c.y}px,0) rotate(40deg)`; });
const order = [2,1,3,0,4];
const leader = $('#leader'), leaderN = $('#leaderN');
let START = 250;
if (!reduced && !location.hash && !/noleader/.test(location.search)){
  START = 2000; leader.hidden = false; let n = 3, t0 = performance.now(), dead = false;
  const finish = () => { if (dead) return; dead = true; leader.animate([{opacity:1},{opacity:0}],{duration:250}).onfinish = () => leader.hidden = true; };
  const spin = now => { if (dead) return; const e = (now - t0)/550; const k = Math.floor(e); leader.style.setProperty('--sweep', ((e%1)*360)+'deg');
    if (3-k !== n){ n = 3-k; if (n <= 0) return finish(); leaderN.textContent = n; } requestAnimationFrame(spin); };
  requestAnimationFrame(spin); setTimeout(finish, 1900);
  leader.addEventListener('click', () => { finish(); dealNow(); });
}
const deep = location.hash.slice(1);
if (cards.some(c => c.el.dataset.key === deep)) setTimeout(() => openSheet(cards.find(c => c.el.dataset.key === deep)), reduced ? 50 : 1300);
const timers = [];
function deal(start){ timers.forEach(clearTimeout); timers.length = 0;
  order.forEach((idx,k) => timers.push(setTimeout(() => { const c = cards[idx]; if (c.active) return; c.active = true;
    setTimeout(() => c.el.classList.add('up'), reduced ? 0 : 380); }, reduced ? 0 : start + k*140))); }
function dealNow(){ deal(150); }
deal(START);

function tick(t){
  const T = t/1000;
  for (const c of cards){
    if (!c.active) continue;
    let tx = c.hx, ty = c.hy, tr = c.hr, ts = 1;
    if (c.drag){ tx = c.px; ty = c.py; tr = c.hr*.3 + Math.max(-28, Math.min(28, c.vx*1.6)); ts = 1.1; }
    else if (c.hover){ ty -= cw*.12; tr = c.hr*.4; ts = 1.07; }
    else if (!reduced){ ty += Math.sin(T*1.1 + c.phase)*3; tr += Math.sin(T*.8 + c.phase)*1.3; }
    c.vx = (c.vx + (tx-c.x)*.14)*.72; c.x += c.vx;
    c.vy = (c.vy + (ty-c.y)*.14)*.72; c.y += c.vy;
    c.vr = (c.vr + (tr-c.r)*.12)*.72; c.r += c.vr;
    c.vs = (c.vs + (ts-c.s)*.2)*.66;  c.s += c.vs;
    c.rx += (c.trx - c.rx)*.15; c.ry += (c.try_ - c.ry)*.15;
    c.el.style.transform = `translate3d(${c.x.toFixed(2)}px,${c.y.toFixed(2)}px,0) rotate(${c.r.toFixed(2)}deg) scale(${c.s.toFixed(3)})`;
    c.tilt.style.setProperty('--rx', c.rx.toFixed(2)+'deg');
    c.tilt.style.setProperty('--ry', c.ry.toFixed(2)+'deg');
  }
  requestAnimationFrame(tick);
}
requestAnimationFrame(tick);

function pointerLocal(c, e){
  const r = c.el.getBoundingClientRect();
  const px = (e.clientX - r.left)/r.width, py = (e.clientY - r.top)/r.height;
  c.trx = (0.5 - py)*22; c.try_ = (px - 0.5)*22;
  c.front.style.setProperty('--mx', (px*100)+'%'); c.front.style.setProperty('--my', (py*100)+'%');
  c.front.style.setProperty('--fx', (px*100)+'%'); c.front.style.setProperty('--fy', (py*100)+'%');
}
function setHover(c, on){
  if (on === c.hover) return; c.hover = on; c.el.classList.toggle('hover', on);
  if (on){ c.vs += .05; c.vr += (Math.random()<.5?-1:1)*3.5; c.el.style.zIndex = 20; }
  else { c.trx = c.try_ = 0; layout(); }
}
cards.forEach(c => {
  const el = c.el;
  el.addEventListener('pointerenter', e => { if (e.pointerType === 'mouse') setHover(c,true); });
  el.addEventListener('pointerleave', () => { if (!c.drag) setHover(c,false); });
  el.addEventListener('pointerdown', e => {
    const tr = table.getBoundingClientRect();
    c.down = { x:e.clientX, y:e.clientY, ox:e.clientX - tr.left - c.x, oy:e.clientY - tr.top - c.y };
    el.setPointerCapture(e.pointerId);
  });
  el.addEventListener('pointermove', e => {
    pointerLocal(c, e);
    if (!c.down) return;
    if (!c.drag && Math.hypot(e.clientX-c.down.x, e.clientY-c.down.y) > 6){ c.drag = true; el.classList.add('dragging'); el.style.zIndex = 30; }
    if (c.drag){ const tr = table.getBoundingClientRect(); c.px = e.clientX - tr.left - c.down.ox; c.py = e.clientY - tr.top - c.down.oy; }
  });
  const end = e => {
    if (!c.down) return;
    const wasDrag = c.drag; c.down = null; c.drag = false; el.classList.remove('dragging');
    if (!wasDrag && e.type === 'pointerup') openSheet(c);
    if (e.pointerType !== 'mouse') setHover(c,false);
    else { const r = el.getBoundingClientRect(); setHover(c, e.clientX>=r.left && e.clientX<=r.right && e.clientY>=r.top && e.clientY<=r.bottom); }
  };
  el.addEventListener('pointerup', end); el.addEventListener('pointercancel', end);
  el.addEventListener('focus', () => setHover(c,true));
  el.addEventListener('blur', () => setHover(c,false));
  el.addEventListener('keydown', e => { if (e.key==='Enter' || e.key===' '){ e.preventDefault(); openSheet(c); } });
});

/* ---------- sheet ---------- */
const sheet = $('#sheet'), sheetCard = $('#sheetCard'), sheetPanel = $('#sheetPanel'), closeBtn = $('#closeBtn');
let openCard = null;
function cardRect(c){ const tr = table.getBoundingClientRect(); return { left: tr.left + c.x, top: tr.top + c.y, width: cw }; }
function openSheet(c){
  if (openCard) return; openCard = c; hideVoice();
  const face = c.front.cloneNode(true); face.querySelectorAll('.shine').forEach(n => n.remove());
  face.style.setProperty('--fx','30%'); face.style.setProperty('--fy','30%');
  sheetCard.innerHTML = ''; sheetCard.appendChild(face);
  sheetPanel.innerHTML = '<div></div>'; sheetPanel.firstChild.appendChild($('#tpl-'+c.el.dataset.key).content.cloneNode(true));
  sheetPanel.scrollTop = 0;
  sheet.hidden = false; closeBtn.hidden = false; document.body.style.overflow = 'hidden';
  c.el.style.visibility = 'hidden';
  const to = sheetCard.getBoundingClientRect(), from = cardRect(c), k = from.width/to.width;
  const dx = from.left - to.left - (to.width - from.width)/2, dy = from.top - to.top - (to.height - to.height*k)/2;
  if (!reduced){
    sheetCard.animate([
      { transform:`translate(${dx}px,${dy}px) rotate(${c.r}deg) scale(${k})` },
      { transform:'translate(0,0) rotate(-4deg) scale(1.04)', offset:.7 },
      { transform:'none' }], { duration:650, easing:'cubic-bezier(.25,1,.5,1)' });
    sheetPanel.animate([{opacity:0, transform:'translateX(40px)'},{opacity:1, transform:'none'}], { duration:500, delay:150, easing:'cubic-bezier(.25,1,.5,1)', fill:'backwards' });
    sheet.animate([{opacity:0},{opacity:1}], { duration:300 });
  }
  closeBtn.focus({preventScroll:true});
  try { history.replaceState(null,'','#'+c.el.dataset.key); } catch(e){}
}
function closeSheet(){
  const c = openCard; if (!c) return;
  try { history.replaceState(null,'',location.pathname + location.search); } catch(e){}
  const done = () => { sheet.hidden = true; closeBtn.hidden = true; document.body.style.overflow = ''; c.el.style.visibility = ''; openCard = null; };
  if (reduced) return done();
  const to = sheetCard.getBoundingClientRect(), from = cardRect(c), k = from.width/to.width;
  const dx = from.left - to.left - (to.width - from.width)/2, dy = from.top - to.top - (to.height - to.height*k)/2;
  sheetCard.animate([{ transform:'none' },{ transform:`translate(${dx}px,${dy}px) rotate(${c.r}deg) scale(${k})` }], { duration:420, easing:'cubic-bezier(.5,0,.2,1)', fill:'forwards' });
  sheetPanel.animate([{opacity:1},{opacity:0}], { duration:200, fill:'forwards' });
  const a = sheet.animate([{opacity:1},{opacity:1, offset:.8},{opacity:0}], { duration:420 });
  a.onfinish = () => { done(); sheetCard.getAnimations().forEach(x=>x.cancel()); sheetPanel.getAnimations().forEach(x=>x.cancel()); };
}
closeBtn.onclick = closeSheet;
sheet.addEventListener('click', e => { if (e.target === sheet || e.target.classList.contains('sheet-cardwrap')) closeSheet(); });
addEventListener('keydown', e => { if (e.key === 'Escape') closeSheet(); });
})();
</script>
</body>
</html>
