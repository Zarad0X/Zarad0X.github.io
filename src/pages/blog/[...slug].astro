---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import { SITE } from "@consts";
import { chapterLabel, chapterNumber, runtimeMinutes } from "@lib/chapters";
export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter(post => !post.data.draft);
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post, chapter: chapterNumber(post, posts), translations: posts.filter(other => post.data.translationKey && other.data.translationKey === post.data.translationKey).sort((a,b) => a.data.lang.localeCompare(b.data.lang)) },
  }));
}
interface Props { post: CollectionEntry<"blog">; chapter: number; translations: CollectionEntry<"blog">[]; }
const { post, chapter, translations } = Astro.props;
const { Content, headings } = await post.render();
const parts = headings.filter(heading => heading.depth === 2);
const zh = post.data.lang === "zh";
const back = zh ? "所有文章" : "All posts";
const runtime = runtimeMinutes(post.body);
const date = new Intl.DateTimeFormat("en-US", { month:"short", day:"2-digit", year:"numeric", timeZone:"UTC" }).format(post.data.date);
---
<PageLayout title={post.data.title} description={post.data.description} lang={post.data.lang} type="article" reading>
  <Fragment slot="head">
    {translations.map(translation => <link rel="alternate" hreflang={translation.data.lang} href={new URL(`/blog/${translation.slug}/`, Astro.site)} />)}
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org", "@type": "BlogPosting",
      headline: post.data.title, description: post.data.description,
      datePublished: post.data.date.toISOString().slice(0,10), inLanguage: post.data.lang === "zh" ? "zh-CN" : "en",
      url: new URL(`/blog/${post.slug}/`, Astro.site).href, mainEntityOfPage: new URL(`/blog/${post.slug}/`, Astro.site).href,
      image: new URL("/assets/og-card.jpg", Astro.site).href,
      author: { "@type": "Person", "@id": new URL("/#person", Astro.site).href, name: "Han Zhang", url: new URL("/", Astro.site).href },
    })} />
  </Fragment>
  <div class="article-toolbar">
    <a class="back-link" href="/blog/">← {back}</a>
    {translations.length > 1 && <div class="language-switch" role="navigation" aria-label="Article language">
      {translations.map((translation,index) => <Fragment>
        {index > 0 && <span aria-hidden="true">/</span>}
        <a href={`/blog/${translation.slug}/`} lang={translation.data.lang} hreflang={translation.data.lang} aria-current={translation.slug === post.slug ? "page" : undefined}>{translation.data.lang === "en" ? "English" : "中文"}</a>
      </Fragment>)}
    </div>}
  </div>
  <article class="blog-article">
    <header class="article-header">
      <p class="chapter-no">{chapterLabel(chapter, zh ? "zh" : "en")}</p>
      <h1>{post.data.title}</h1><p class="article-description">{post.data.description}</p>
      <p class="article-date"><time datetime={post.data.date.toISOString().slice(0,10)}>{date}</time> · <span class="runtime">{zh ? `片长 ${runtime} 分钟` : `Runtime ${runtime} min`}</span></p>
    </header>
    {parts.length > 0 && <details class="article-contents"><summary>{zh ? "目录" : "In this essay"}</summary><ol>{parts.map(part => <li><a href={`#${part.slug}`}>{part.text}</a></li>)}</ol></details>}
    <div class="script-page">
      <p class="transition">{zh ? "淡入：" : "Fade in:"}</p>
      <div class="prose"><Content /></div>
      <p class="transition">{zh ? "淡出。" : "Fade out."}</p>
    </div>
  </article>
  <div class="reel" id="reel" aria-hidden="true" data-runtime={runtime * 60}><div class="reel-fill" id="reelFill"></div><span class="reel-tc" id="reelTc">REEL 1 · 00:00:00</span></div>
  <script is:inline>
  (() => {
    const reel = document.getElementById("reel"), fill = document.getElementById("reelFill"), tc = document.getElementById("reelTc");
    const art = document.querySelector(".blog-article"), total = +reel.dataset.runtime || 60;
    const heads = [...document.querySelectorAll(".prose h2")];
    const pad = n => String(Math.floor(n)).padStart(2, "0");
    let ticking = false;
    function update(){
      ticking = false;
      const r = art.getBoundingClientRect(), vh = innerHeight;
      const k = Math.min(1, Math.max(0, (vh * 0.35 - r.top) / Math.max(1, r.height - vh * 0.5)));
      fill.style.transform = `scaleX(${k})`;
      const t = k * total, reelNo = 1 + heads.filter(h => h.getBoundingClientRect().top < vh * 0.35).length;
      tc.textContent = `REEL ${reelNo} · ${pad(t / 3600)}:${pad(t / 60 % 60)}:${pad(t % 60)}`;
      reel.classList.toggle("on", scrollY > 60);
    }
    addEventListener("scroll", () => { if (!ticking){ ticking = true; requestAnimationFrame(update); } }, { passive: true });
    addEventListener("resize", update); update();
  })();
  </script>
  <div class="article-end"><a href="/blog/">← {back}</a><a href={`mailto:${SITE.EMAIL}`}>{zh ? "联系我" : "Get in touch"} ↗</a></div>
</PageLayout>
