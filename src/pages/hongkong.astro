---
import PageLayout from "@layouts/PageLayout.astro";
import map from "@data/hkmap.json";
import { places, kindName } from "@data/places";

const { proj, crop, districts, inset } = map;
// same equirectangular projection as the map build, in crop units (0..1000 wide)
const toXY = (lon: number, lat: number) => [
  ((lon - proj.LON0) * proj.K * proj.SCALE - proj.x0) * proj.S,
  ((proj.LAT0 - lat) * proj.SCALE - proj.y0) * proj.S,
];
const W = crop.w, H = crop.h;
const pts = places.map(p => toXY(p.lon, p.lat));
const pct = pts.map(([x, y]) => [((x / W) * 100).toFixed(3), ((y / H) * 100).toFixed(3)]);
const pad = (n: number) => String(n).padStart(2, "0");
const labelled = new Set(["中西區", "灣仔區", "東區", "油尖旺區", "深水埗區", "九龍城區", "觀塘區", "西貢區", "黃大仙區"]);
const water = [
  { zh: "維多利亞港", en: "Victoria Harbour", lon: 114.1660, lat: 22.2895 },
  { zh: "將軍澳", en: "Junk Bay", lon: 114.2465, lat: 22.2930 },
  { zh: "清水灣", en: "Clear Water Bay", lon: 114.2850, lat: 22.3200 },
].map(w => ({ ...w, xy: toXY(w.lon, w.lat) }));
const cards = places.map((p, i) => ({ ...p, n: pad(i + 1), kindLabel: kindName[p.kind] }));
---
<PageLayout title="Location Scout · Hong Kong" description="Places in Hong Kong Han Zhang keeps going back to, pinned on a hand-drawn map and strung together in red.">
  <div class="standalone-heading scout-heading">
    <span class="kicker">港 · Location scout</span>
    <h1>Hong Kong</h1>
    <p>Places in this city I keep going back to, pinned to the map and strung together, west to east.</p>
  </div>

  <div class="scout" id="scout">
    <div class="board" id="board">
      <span class="tape t1" aria-hidden="true"></span><span class="tape t2" aria-hidden="true"></span>
      <div class="case-label" aria-hidden="true"><b>CASE FILE</b>香港 · {places.length} locations</div>
      <div class="viewport" id="viewport">
        <div class="stage" id="stage">
          <svg class="hkmap" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" role="img" aria-label="Hand-drawn map of Hong Kong from Central to Clear Water Bay">
            <defs>
              <pattern id="sea" width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                <circle cx="4.5" cy="4.5" r="1.25" class="sea-dot" />
              </pattern>
              <filter id="mapRough" x="-2%" y="-2%" width="104%" height="104%">
                <feTurbulence type="fractalNoise" baseFrequency="0.02" numOctaves="2" seed="11" />
                <feDisplacementMap in="SourceGraphic" scale="2.2" />
              </filter>
            </defs>
            <rect class="sea" width={W} height={H} />
            <rect class="sea-dots" width={W} height={H} fill="url(#sea)" />
            <g class="land" filter="url(#mapRough)">
              {districts.map(d => <path d={d.d} />)}
            </g>
            <g class="labels" aria-hidden="true">
              {districts.filter(d => labelled.has(d.zh)).map(d => (
                <text x={d.c[0]} y={d.c[1]} class="dist"><tspan class="dz">{d.zh.replace(/區$/, "")}</tspan><tspan class="de" x={d.c[0]} dy="13">{d.en}</tspan></text>
              ))}
              {water.map(w => (
                <text x={w.xy[0]} y={w.xy[1]} class="water"><tspan>{w.zh}</tspan><tspan x={w.xy[0]} dy="14">{w.en.toUpperCase()}</tspan></text>
              ))}
            </g>
          </svg>
          <svg class="overlay" id="overlay" aria-hidden="true"><g id="leaders"></g><path id="string" class="string" /></svg>
          {cards.map((p, i) => (
            <button class={`pin${p.approx ? " approx" : ""}`} type="button" data-i={i} style={`left:${pct[i][0]}%;top:${pct[i][1]}%`}
              aria-label={`Scene ${p.n}: ${p.en}`}>
              <span class="head"><span class="num">{p.n}</span></span>
              <span class={`placard k-${p.kind}`}><b>{p.zh}</b><small>{p.en}</small></span>
            </button>
          ))}
        </div>
      </div>
      <svg class="inset" viewBox={`0 0 ${inset.w} ${inset.h}`} aria-hidden="true">
        <rect width={inset.w} height={inset.h} class="inset-bg" />
        <path d={inset.d} class="inset-land" />
        <rect x={inset.frame[0]} y={inset.frame[1]} width={inset.frame[2]} height={inset.frame[3]} class="inset-frame" />
        <text x="6" y="12" class="inset-t">HONG KONG · 香港</text>
      </svg>
      <button class="zoom-out" id="zoomOut" type="button" hidden>← Wide shot</button>
    </div>

    <aside class="scene" id="scene" hidden aria-live="polite">
      <button class="scene-x" id="sceneClose" type="button" aria-label="Close scene">✕</button>
      <p class="scene-no" id="sceneNo"></p>
      <p class="scene-slug" id="sceneSlug"></p>
      <h2 class="scene-zh" id="sceneZh"></h2>
      <p class="scene-en" id="sceneEn"></p>
      <p class="scene-meta" id="sceneMeta"></p>
      <div class="screen" id="screen"><p class="sub-zh" id="subZh"></p><p class="sub-en" id="subEn"></p></div>
      <div class="scene-nav"><button type="button" id="prevScene">← Prev</button><button type="button" id="nextScene">Next →</button></div>
    </aside>
  </div>

  <h2 class="list-sign">Shot list</h2>
  <ol class="shot-list">
    {cards.map((p, i) => (
      <li><button type="button" data-i={i}>
        <span class="sl-n">{p.n}</span>
        <span class="sl-body"><span class="sl-slug">{p.slug}</span><span class="sl-name">{p.zh}{p.en !== p.zh && <em>{p.en}</em>}</span>
          {(p.note?.en || p.note?.zh) && <span class="sl-note">{p.note?.zh}{p.note?.zh && p.note?.en ? " · " : ""}{p.note?.en}</span>}</span>
        <span class="sl-kind">{p.kindLabel}</span>
      </button></li>
    ))}
  </ol>
  <p class="credits">Coastline © OpenStreetMap contributors (ODbL). District boundaries: Home Affairs Department, HKSAR, via DATA.GOV.HK. Drawn and simplified for this page; not for navigation.</p>

  <script is:inline define:vars={{ cards, pts, W, H }}>
  (() => {
    const scout = document.getElementById("scout"), viewport = document.getElementById("viewport"), stage = document.getElementById("stage");
    const overlay = document.getElementById("overlay"), stringPath = document.getElementById("string"), leaders = document.getElementById("leaders");
    const pins = [...stage.querySelectorAll(".pin")], scene = document.getElementById("scene"), zoomOut = document.getElementById("zoomOut");
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let active = -1, zoom = 1, pos = [];

    // pin heads stay a constant on-screen size; nudge apart any that would overlap and draw a leader to the true spot
    function layout() {
      const w = viewport.clientWidth, h = viewport.clientHeight;
      overlay.setAttribute("viewBox", `0 0 ${w} ${h}`);
      const truth = pts.map(([x, y]) => [x / W * w, y / H * h]);
      pos = truth.map(p => p.slice());
      const min = (w < 520 ? 22 : 28) / zoom;
      for (let it = 0; it < 80; it++) {
        for (let i = 0; i < pos.length; i++) for (let j = i + 1; j < pos.length; j++) {
          let dx = pos[j][0] - pos[i][0], dy = pos[j][1] - pos[i][1], d = Math.hypot(dx, dy) || 0.01;
          if (d < min) { const push = (min - d) / 2; dx /= d; dy /= d; pos[i][0] -= dx * push; pos[i][1] -= dy * push; pos[j][0] += dx * push; pos[j][1] += dy * push; }
        }
        pos.forEach((p, i) => { p[0] += (truth[i][0] - p[0]) * 0.04; p[1] += (truth[i][1] - p[1]) * 0.04; });
      }
      pins.forEach((el, i) => {
        el.style.left = pos[i][0] + "px"; el.style.top = pos[i][1] + "px";
        el.style.setProperty("--z", zoom);
      });
      leaders.innerHTML = truth.map((t, i) => Math.hypot(t[0] - pos[i][0], t[1] - pos[i][1]) > 3
        ? `<line x1="${t[0]}" y1="${t[1]}" x2="${pos[i][0]}" y2="${pos[i][1]}" class="leader"/><circle cx="${t[0]}" cy="${t[1]}" r="${2.2 / zoom}" class="leader-dot"/>` : "").join("");
      // red string, sagging a little between pins
      let d = `M${pos[0][0]} ${pos[0][1]}`;
      for (let i = 1; i < pos.length; i++) {
        const [ax, ay] = pos[i - 1], [bx, by] = pos[i], sag = Math.min(40, Math.hypot(bx - ax, by - ay) * 0.12) / zoom;
        d += ` Q${(ax + bx) / 2} ${(ay + by) / 2 + sag} ${bx} ${by}`;
      }
      stringPath.setAttribute("d", d);
      stringPath.style.strokeWidth = (2 / zoom) + "px";
    }

    function camera(i) {
      const w = viewport.clientWidth, h = viewport.clientHeight;
      if (i < 0) { zoom = 1; stage.style.transform = "none"; }
      else {
        zoom = w < 520 ? 2.6 : 2.2;
        const [x, y] = pos[i];
        const tx = Math.min(0, Math.max(w - w * zoom, w / 2 - x * zoom)), ty = Math.min(0, Math.max(h - h * zoom, h / 2 - y * zoom));
        stage.style.transform = `translate(${tx}px, ${ty}px) scale(${zoom})`;
      }
      scout.classList.toggle("zoomed", i >= 0);
      zoomOut.hidden = i < 0;
      layout();
    }

    const set = (id, v) => { document.getElementById(id).textContent = v || ""; };
    function open(i) {
      if (active === i) return;
      active = i;
      const c = cards[i];
      pins.forEach((p, j) => p.classList.toggle("on", j === i));
      set("sceneNo", `Scene ${c.n} / ${String(cards.length).padStart(2, "0")}`);
      set("sceneSlug", c.slug);
      set("sceneZh", c.zh); set("sceneEn", c.en === c.zh ? "" : c.en);
      set("sceneMeta", [c.kindLabel, c.when, c.approx ? "approximate area" : ""].filter(Boolean).join(" · "));
      set("subZh", c.note?.zh); set("subEn", c.note?.en);
      document.getElementById("screen").classList.toggle("empty", !(c.note?.zh || c.note?.en));
      scene.hidden = false;
      camera(i);
    }
    function close() {
      active = -1; scene.hidden = true; pins.forEach(p => p.classList.remove("on")); camera(-1);
    }
    pins.forEach((el, i) => el.addEventListener("click", () => (active === i ? close() : open(i))));
    document.querySelectorAll(".shot-list button").forEach(b => b.addEventListener("click", () => {
      open(+b.dataset.i); scout.scrollIntoView({ behavior: reduced ? "auto" : "smooth", block: "start" });
    }));
    document.getElementById("sceneClose").addEventListener("click", close);
    zoomOut.addEventListener("click", close);
    document.getElementById("prevScene").addEventListener("click", () => open((active - 1 + cards.length) % cards.length));
    document.getElementById("nextScene").addEventListener("click", () => open((active + 1) % cards.length));
    addEventListener("keydown", e => {
      if (scene.hidden) return;
      if (e.key === "Escape") close();
      if (e.key === "ArrowRight") open((active + 1) % cards.length);
      if (e.key === "ArrowLeft") open((active - 1 + cards.length) % cards.length);
    });
    addEventListener("resize", () => camera(active));
    layout();
    // draw the string in once, the first time the board scrolls into view
    if (!reduced && "IntersectionObserver" in window) {
      const len = stringPath.getTotalLength();
      stringPath.style.strokeDasharray = len; stringPath.style.strokeDashoffset = len;
      new IntersectionObserver((es, ob) => { if (es[0].isIntersecting) { stringPath.classList.add("draw"); ob.disconnect(); setTimeout(() => { stringPath.style.strokeDasharray = ""; stringPath.style.strokeDashoffset = ""; }, 2600); } }, { threshold: 0.3 }).observe(viewport);
    }
  })();
  </script>
</PageLayout>

<style is:global>
.scout-heading{max-width:none}
.scout{position:relative;display:grid;grid-template-columns:1fr;gap:18px;margin:6px 0 40px;
  --paper:#f7ecd2;--sea:#d8cfb6;--dot:rgba(29,42,74,.32);--ink:#141010;--pin:#d3241c;--string:#c8102e;--label:rgba(20,16,16,.55)}
html.night .scout{--paper:#0e131d;--sea:#06090f;--dot:rgba(92,225,255,.16);--ink:#5ce1ff;--pin:#ff2d55;--string:#ff2d55;--label:rgba(160,230,255,.55)}

/* evidence board */
.board{position:relative;background:var(--paper);border:2px solid #141010;box-shadow:8px 8px 0 var(--hard);padding:10px}
html.night .board{border-color:#2a3550;box-shadow:8px 8px 0 #ff2d55}
.tape{position:absolute;width:86px;height:24px;background:rgba(246,196,0,.55);z-index:5;box-shadow:0 1px 0 rgba(0,0,0,.08)}
.tape.t1{left:-18px;top:14px;transform:rotate(-38deg)}.tape.t2{right:-18px;top:14px;transform:rotate(38deg)}
.case-label{position:absolute;left:22px;top:20px;z-index:4;background:#fffbe8;border:1.5px solid #141010;padding:5px 10px 4px;font:700 11px/1.3 var(--mono);color:#141010;
  transform:rotate(-1.5deg);box-shadow:2px 2px 0 rgba(20,16,16,.85)}
.case-label b{display:block;font-family:var(--anton);font-weight:400;font-size:15px;letter-spacing:.18em;color:#d3241c}
.viewport{position:relative;overflow:hidden;aspect-ratio:1000/610;background:var(--sea)}
.stage{position:absolute;inset:0;transform-origin:0 0;transition:transform .9s cubic-bezier(.65,0,.25,1)}
.hkmap,.overlay{position:absolute;inset:0;width:100%;height:100%;display:block}
.sea{fill:var(--sea)}.sea-dot{fill:var(--dot)}
.land path{fill:var(--paper);stroke:var(--ink);stroke-width:1.1;stroke-linejoin:round}
html.night .land path{fill:#121826;stroke-width:1.3;filter:drop-shadow(0 0 2.5px rgba(92,225,255,.85))}
.labels text{font-family:"Courier Prime",monospace;fill:var(--label);text-anchor:middle;pointer-events:none}
.labels .dz{font-family:"Noto Serif SC","Songti SC",serif;font-weight:700;font-size:15px;letter-spacing:.15em}
.labels .de{font-size:9.5px;letter-spacing:.14em;text-transform:uppercase}
.labels .water{font-size:11px;letter-spacing:.3em;font-style:italic;fill:rgba(29,42,74,.55)}
.labels .water tspan:first-child{font-family:"Noto Serif SC","Songti SC",serif;font-style:normal;font-size:14px;letter-spacing:.5em}
html.night .labels .water{fill:rgba(92,225,255,.45)}
.string{fill:none;stroke:var(--string);stroke-linecap:round;filter:drop-shadow(0 1px 1px rgba(0,0,0,.35))}
html.night .string{filter:drop-shadow(0 0 3px #ff2d55)}
.string.draw{transition:stroke-dashoffset 2.4s ease-in-out;stroke-dashoffset:0!important}
.leader{stroke:var(--ink);stroke-width:1;stroke-dasharray:2 2;opacity:.7}.leader-dot{fill:var(--ink)}

/* pins: constant screen size even when the camera pushes in */
.pin{position:absolute;width:0;height:0;padding:0;border:0;background:none;cursor:pointer;z-index:2;transform:scale(calc(1 / var(--z,1)))}
.pin .head{position:absolute;left:-13px;top:-13px;width:26px;height:26px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#ff7a6e,var(--pin) 55%,#8c0f0a);
  border:2px solid #141010;box-shadow:2px 3px 0 rgba(20,16,16,.55);display:grid;place-items:center;transition:transform .25s cubic-bezier(.34,1.56,.64,1)}
html.night .pin .head{border-color:#ffd0da;box-shadow:0 0 10px #ff2d55,0 0 22px rgba(255,45,85,.55)}
.pin .num{font:700 10px/1 var(--mono);color:#fff;letter-spacing:-.02em}
.pin.approx .head::after{content:"";position:absolute;inset:-12px;border-radius:50%;border:2px dashed var(--pin);opacity:.7}
.pin:hover .head,.pin:focus-visible .head,.pin.on .head{transform:scale(1.2)}
.pin:focus-visible{outline:none}.pin:focus-visible .head{outline:3px solid #f6c400;outline-offset:2px}
.pin.on{z-index:4}
.pin:hover,.pin:focus-visible{z-index:6}
/* Hong Kong minibus placard */
.placard{position:absolute;left:16px;top:-30px;display:flex;flex-direction:column;align-items:flex-start;white-space:nowrap;padding:4px 9px 3px;border-radius:5px;
  background:#0b7a3b;color:#fff;border:2px solid #fff;box-shadow:0 0 0 2px #141010,3px 3px 0 2px rgba(20,16,16,.6);opacity:0;transform:translateY(4px) scale(.9);
  transform-origin:0 100%;transition:opacity .15s,transform .2s;pointer-events:none}
.placard b{font-family:"Noto Serif SC","Songti SC",serif;font-weight:900;font-size:15px;letter-spacing:.06em;line-height:1.15}
.placard small{font:700 9px/1.2 var(--mono);letter-spacing:.08em;text-transform:uppercase;opacity:.9}
.placard.k-night,.placard.k-shopping,.placard.k-food,.placard.k-cinema{background:#c8102e}
.pin:hover .placard,.pin:focus-visible .placard,.pin.on .placard{opacity:1;transform:none}
html.night .placard{box-shadow:0 0 0 2px #000,0 0 14px rgba(255,255,255,.25)}

.inset{position:absolute;left:18px;bottom:18px;width:150px;height:auto;z-index:3;border:1.5px solid #141010;box-shadow:3px 3px 0 rgba(20,16,16,.8);background:#fffbe8}
.inset-bg{fill:#e6dcc3}.inset-land{fill:#fffbe8;stroke:#141010;stroke-width:.5}.inset-frame{fill:rgba(211,36,28,.12);stroke:#d3241c;stroke-width:1.4}
.inset-t{font:700 7px "Courier Prime",monospace;letter-spacing:.12em;fill:#141010}
html.night .inset{background:#0e131d;border-color:#2a3550}html.night .inset-bg{fill:#06090f}html.night .inset-land{fill:#121826;stroke:#5ce1ff}html.night .inset-t{fill:#9fe8ff}
.zoom-out{position:absolute;right:18px;top:20px;z-index:6;font:700 12px/1 var(--mono);text-transform:uppercase;letter-spacing:.06em;background:#141010;color:#f6c400;
  border:2px solid #141010;padding:8px 11px;cursor:pointer;box-shadow:3px 3px 0 #d3241c}

/* scene card */
.scene{position:absolute;right:26px;bottom:26px;z-index:7;width:min(360px,calc(100% - 52px));background:#fffbe8;color:#141010;border:2px solid #141010;
  box-shadow:6px 6px 0 rgba(20,16,16,.9);padding:16px 18px 14px;animation:scene-in .35s cubic-bezier(.34,1.56,.64,1)}
.scene[hidden]{display:none}
@keyframes scene-in{from{opacity:0;transform:translateY(14px) rotate(1deg)}to{opacity:1;transform:none}}
html.night .scene{box-shadow:6px 6px 0 #ff2d55}
.scene-x{position:absolute;right:8px;top:8px;width:30px;height:30px;border:2px solid #141010;background:#fffbe8;cursor:pointer;font-weight:700}
.scene-no{margin:0;font-family:var(--anton);font-size:14px;letter-spacing:.24em;color:#d3241c;text-transform:uppercase}
.scene-slug{margin:6px 34px 10px 0;font:700 12px/1.45 var(--mono);text-transform:uppercase;text-decoration:underline;text-underline-offset:3px}
.scene-zh{margin:0;font-family:"Noto Serif SC","Songti SC",serif;font-weight:900;font-size:26px;line-height:1.25}
.scene-en:empty{display:none}
.scene-en{margin:2px 0 0;font-family:var(--anton);font-size:18px;letter-spacing:.02em;text-transform:uppercase}
.scene-meta{margin:6px 0 10px;font:700 11px/1.4 var(--mono);letter-spacing:.08em;text-transform:uppercase;color:rgba(20,16,16,.6)}
/* Hong Kong film subtitles: yellow Chinese over white English, black outline, on a dark frame */
.screen{background:#0a0a0a;padding:16px 12px 12px;text-align:center;min-height:62px;display:flex;flex-direction:column;justify-content:flex-end}
.screen.empty{display:none}
.sub-zh{margin:0;font-family:"Noto Serif SC","Songti SC",serif;font-weight:700;font-size:19px;color:#ffe34d;letter-spacing:.06em;
  text-shadow:-1.5px -1.5px 0 #000,1.5px -1.5px 0 #000,-1.5px 1.5px 0 #000,1.5px 1.5px 0 #000}
.sub-en{margin:4px 0 0;font:600 14px/1.35 "Courier Prime",monospace;color:#fff;text-shadow:-1px -1px 0 #000,1px -1px 0 #000,-1px 1px 0 #000,1px 1px 0 #000}
.sub-zh:empty,.sub-en:empty{display:none}
.scene-nav{display:flex;justify-content:space-between;margin-top:12px}
.scene-nav button{font:700 11px/1 var(--mono);letter-spacing:.06em;text-transform:uppercase;background:none;border:0;border-bottom:2px solid #d3241c;color:#141010;padding:4px 0;cursor:pointer}

/* shot list */
.list-sign{display:inline-block;font-family:var(--anton);font-weight:400;font-size:18px;letter-spacing:.22em;text-transform:uppercase;background:var(--strong);color:var(--yellow);
  padding:6px 12px 4px;margin:10px 0 16px;transform:rotate(-1.5deg);box-shadow:3px 3px 0 var(--red)}
html.night .list-sign{background:#000;color:var(--yellow);border:1.5px solid #3a2f27}
.shot-list{list-style:none;margin:0 0 24px;padding:0;border-top:2px solid var(--strong)}
.shot-list button{width:100%;display:grid;grid-template-columns:44px 1fr auto;gap:12px;align-items:baseline;text-align:left;background:none;border:0;border-bottom:1px dashed var(--line);
  padding:12px 4px;cursor:pointer;color:var(--text);font:inherit}
.shot-list button:hover{background:var(--tint)}
.sl-n{font-family:var(--anton);font-size:22px;color:var(--red)}
html.night .sl-n{color:var(--yellow)}
.sl-body{display:flex;flex-direction:column;gap:3px}
.sl-slug{font:700 12px/1.4 var(--mono);text-transform:uppercase;letter-spacing:.03em}
.sl-name{font-family:"Noto Serif SC","Songti SC",serif;font-weight:700;font-size:16px}
.sl-name em{font-family:var(--mono);font-style:normal;font-weight:400;font-size:13px;color:var(--muted);margin-left:6px}
.sl-note{font:13px/1.5 var(--mono);color:var(--muted)}
.sl-kind{font:700 10px/1 var(--mono);letter-spacing:.12em;text-transform:uppercase;border:1.5px solid var(--strong);padding:4px 7px;white-space:nowrap}
.credits{font:11px/1.6 var(--mono);color:var(--quiet);margin:0 0 10px}

@media(max-width:760px){
  .board{padding:6px}
  .case-label{left:12px;top:12px;font-size:9px;padding:4px 7px 3px}.case-label b{font-size:12px}
  .inset{display:none}
