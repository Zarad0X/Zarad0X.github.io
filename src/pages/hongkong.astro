---
import PageLayout from "@layouts/PageLayout.astro";
import map from "@data/hkmap.json";
import { places, kindName } from "@data/places";

const { proj, crop, districts, inset } = map;
// same equirectangular projection as the map build, in crop units (0..1000 wide)
const toXY = (lon: number, lat: number) => [
  ((lon - proj.LON0) * proj.K * proj.SCALE - proj.x0) * proj.S,
  ((proj.LAT0 - lat) * proj.SCALE - proj.y0) * proj.S,
];
const W = crop.w, H = crop.h;
const pts = places.map(p => toXY(p.lon, p.lat));
const pct = pts.map(([x, y]) => [((x / W) * 100).toFixed(3), ((y / H) * 100).toFixed(3)]);
const pad = (n: number) => String(n).padStart(2, "0");
const labelled = new Set(["中西區", "灣仔區", "東區", "油尖旺區", "深水埗區", "九龍城區", "觀塘區", "西貢區", "黃大仙區"]);
const water = [
  { zh: "維多利亞港", en: "Victoria Harbour", lon: 114.1660, lat: 22.2895 },
  { zh: "將軍澳", en: "Junk Bay", lon: 114.2465, lat: 22.2930 },
  { zh: "清水灣", en: "Clear Water Bay", lon: 114.2850, lat: 22.3200 },
].map(w => ({ ...w, xy: toXY(w.lon, w.lat) }));
const cards = places.map((p, i) => ({ ...p, n: pad(i + 1), kindLabel: kindName[p.kind] }));

// ---- the living layer: ferries, trams, a junk, landmarks, the night's events ----
const XY = (lon: number, lat: number) => toXY(lon, lat).map(v => +v.toFixed(1));
const line = (pts: number[][]) => "M" + pts.map(([lon, lat]) => XY(lon, lat).join(" ")).join(" L");
const [fa, fb] = [XY(114.1608, 22.2873), XY(114.1686, 22.2937)];                   // Central Pier 7 ↔ TST Star Ferry Pier
const ferryRoute = `M${fa[0]} ${fa[1]} Q${(fa[0] + fb[0]) / 2 + 14} ${(fa[1] + fb[1]) / 2 + 10} ${fb[0]} ${fb[1]}`;
const tramRoute = line([[114.1545, 22.2830], [114.1600, 22.2810], [114.1650, 22.2790], [114.1700, 22.2776], [114.1760, 22.2772],
  [114.1810, 22.2784], [114.1860, 22.2800], [114.1900, 22.2814]]);                     // Kennedy Town-ish → Causeway Bay
const [ja, jm, jb] = [XY(114.1500, 22.2915), XY(114.1720, 22.2893), XY(114.1915, 22.2900)];
const junkRoute = `M${ja[0]} ${ja[1]} Q${jm[0]} ${jm[1] + 4} ${jb[0]} ${jb[1]}`;
const ifc = XY(114.1590, 22.2856), icc = XY(114.1604, 22.3040);
const pumpkin = XY(114.1522, 22.2793), fireworks = XY(114.1766, 22.2884);
const peak = XY(114.1500, 22.2712);                                                      // Peak Tower, Victoria Peak
const peakTram = line([[114.1592, 22.2778], [114.1560, 22.2752], [114.1528, 22.2730], [114.1503, 22.2716]]);
const cruise = XY(114.2155, 22.3045);                                                    // Kai Tak Cruise Terminal
const [pa, pb] = [XY(114.1380, 22.3420), XY(114.2050, 22.3110)];                        // a jet coming in over Kowloon City
const planeRoute = `M${pa[0]} ${pa[1]} Q${(pa[0] + pb[0]) / 2} ${(pa[1] + pb[1]) / 2 - 18} ${pb[0]} ${pb[1]}`;
const signs = [{ xy: XY(114.1712, 22.3150), t: ["押"], c: "#ff2d55", bat: true }, { xy: XY(114.1738, 22.3122), t: ["茶", "餐", "廳"], c: "#5ce1ff" },
  { xy: XY(114.1690, 22.3112), t: ["酒", "家"], c: "#ffcf3a" }];
const burst = (r0: number, r1: number) => Array.from({ length: 12 }, (_, k) => {
  const a = (k / 12) * Math.PI * 2, c = Math.cos(a), s = Math.sin(a);
  return `M${(c * r0).toFixed(1)} ${(s * r0).toFixed(1)} L${(c * r1).toFixed(1)} ${(s * r1).toFixed(1)}`;
}).join(" ");
---
<PageLayout title="Location Scout · Hong Kong" description="Places in Hong Kong Han Zhang keeps going back to, pinned on a hand-drawn map and strung together in red.">
  <div class="standalone-heading scout-heading">
    <span class="kicker">港 · Location scout</span>
    <h1>Hong Kong</h1>
    <p>Places in this city I keep going back to, pinned to the map and strung together, west to east.</p>
  </div>

  <div class="scout" id="scout">
    <div class="board" id="board">
      <span class="tape t1" aria-hidden="true"></span><span class="tape t2" aria-hidden="true"></span>
      <div class="case-label" aria-hidden="true"><b>CASE FILE</b>香港 · {places.length} locations</div>
      <div class="hk-now" id="hkNow"><b>HKT</b> <span id="hkTime">--:--</span><span id="hkWx"></span></div>
      <div class="viewport" id="viewport">
        <div class="stage" id="stage">
          <svg class="hkmap" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" role="img" aria-label="Hand-drawn map of Hong Kong from Central to Clear Water Bay">
            <defs>
              <pattern id="sea" width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                <circle cx="4.5" cy="4.5" r="1.25" class="sea-dot" />
              </pattern>
              <filter id="mapRough" x="-2%" y="-2%" width="104%" height="104%">
                <feTurbulence type="fractalNoise" baseFrequency="0.02" numOctaves="2" seed="11" />
                <feDisplacementMap in="SourceGraphic" scale="2.2" />
              </filter>
            </defs>
            <rect class="sea" width={W} height={H} />
            <rect class="sea-dots" width={W} height={H} fill="url(#sea)" />
            <g class="land" filter="url(#mapRough)">
              {districts.map(d => <path d={d.d} />)}
            </g>
            <g class="labels" aria-hidden="true">
              {districts.filter(d => labelled.has(d.zh)).map(d => {
                const [x, y] = d.zh === "中西區" ? [d.c[0] - 38, d.c[1] + 46] : d.c;   // keep clear of the Peak doodle
                return <text x={x} y={y} class="dist"><tspan class="dz">{d.zh.replace(/區$/, "")}</tspan><tspan class="de" x={x} dy="13">{d.en}</tspan></text>;
              })}
              {water.map(w => (
                <text x={w.xy[0]} y={w.xy[1]} class="water"><tspan>{w.zh}</tspan><tspan x={w.xy[0]} dy="14">{w.en.toUpperCase()}</tspan></text>
              ))}
            </g>
            <g class="life" aria-hidden="true">
              <path id="ferryRoute" d={ferryRoute} class="route" />
              <path id="tramRoute" d={tramRoute} class="route tram-track" />
              <path id="junkRoute" d={junkRoute} fill="none" stroke="none" />
              <g class="lm" transform={`translate(${ifc[0]} ${ifc[1]})`}>
                <path d="M-5 0 V-44 L-3.5 -49 V-55 L-1.5 -59 L0 -66 L1.5 -59 L3.5 -55 V-49 L5 -44 V0 Z" class="tower" />
                <path d="M-5 -8 h10 M-5 -16 h10 M-5 -24 h10 M-5 -32 h10 M-5 -40 h10" class="floors" />
                <text y="9" class="lm-t">IFC</text>
              </g>
              <g class="lm" transform={`translate(${icc[0]} ${icc[1]})`}>
                <path d="M-5.5 0 V-64 L-4 -69 L4 -69 L5.5 -64 V0 Z" class="tower" />
                <path d="M-5.5 -9 h11 M-5.5 -18 h11 M-5.5 -27 h11 M-5.5 -36 h11 M-5.5 -45 h11 M-5.5 -54 h11" class="floors" />
                <text y="9" class="lm-t">ICC</text>
              </g>
              <g class="pumpkin" transform={`translate(${pumpkin[0]} ${pumpkin[1]}) scale(1.5)`}>
                <path d="M0 -6.5 q1 -3 3 -3.5" class="stem" />
                <ellipse cx="0" cy="0" rx="8" ry="6.5" class="gourd" />
                <path d="M-3 -6 q-2 6 0 12.5 M3 -6 q2 6 0 12.5" class="ribs" />
                <path d="M-4.5 -2 l2 -2 l1 2.5 z M4.5 -2 l-2 -2 l-1 2.5 z M-4 2 q4 3 8 0 l-2 1.2 l-1 -1 l-1 1 l-1 -1 l-1 1 z" class="face" />
              </g>
              <g class="fireworks" transform={`translate(${fireworks[0]} ${fireworks[1]})`}>
                <g transform="translate(-16 -6)"><path d={burst(3, 15)} class="burst b1" /></g>
                <g transform="translate(14 -14)"><path d={burst(2, 11)} class="burst b2" /></g>
                <g transform="translate(2 4)"><path d={burst(2.5, 13)} class="burst b3" /></g>
              </g>
              <path d={peakTram} class="route peak-tram" />
              <g class="lm peak" transform={`translate(${peak[0]} ${peak[1]})`}>
                <path d="M-16 -4 Q0 -14 16 -4 L12 -2 L-12 -2 Z" class="tower" />
                <path d="M-6 -2 V6 M6 -2 V6 M-10 6 h20" class="floors" style="opacity:.9" />
                <text y="16" class="lm-t">THE PEAK</text>
              </g>
              <g class="cruise" transform={`translate(${cruise[0]} ${cruise[1]}) rotate(-38) scale(1.4)`}>
                <path d="M-20 2 L18 2 L22 -2 L-22 -2 Z" class="hull-w" />
                <path d="M-16 -2 V-6 H12 V-2 M-12 -6 V-9 H6 V-6" class="deck-w" />
                <path d="M-14 -4 h24" class="portholes" />
              </g>
              <g class="signs">
                {signs.map(sg => (
                  <g transform={`translate(${sg.xy[0]} ${sg.xy[1]})`} style={`--c:${sg.c}`} class="sign">
                    <rect x="-7" y="-4" width="14" height={sg.t.length * 13 + 6} rx="2" class="sign-box" />
                    {sg.bat && <path d="M-11 -9 q4 -4 11 0 q7 -4 11 0 q-4 0 -5 3 q-6 -3 -12 0 q-1 -3 -5 -3 z" class="sign-bat" />}
                    {sg.t.map((ch, k) => <text x="0" y={k * 13 + 7} class="sign-t">{ch}</text>)}
                  </g>
                ))}
              </g>
              <path id="planeRoute" d={planeRoute} fill="none" stroke="none" />
              <g class="plane">
                <g transform="scale(1.7)">
                  <path d="M-12 0 Q-12 -2 -9 -2 L9 -2 Q13 -2 14 0 Q13 2 9 2 L-9 2 Q-12 2 -12 0 Z" class="fuselage" />
                  <path d="M-2 -1.5 L-7 -10 L-4 -10 L4 -1.5 Z M-2 1.5 L-7 10 L-4 10 L4 1.5 Z M-10 -1.5 L-13 -6 L-11 -6 L-7 -1.5 Z M-10 1.5 L-13 6 L-11 6 L-7 1.5 Z" class="wing" />
                </g>
                <animateMotion dur="48s" repeatCount="indefinite" rotate="auto" keyPoints="0;1;1" keyTimes="0;0.35;1" calcMode="linear"><mpath href="#planeRoute" /></animateMotion>
                <animate attributeName="opacity" dur="48s" repeatCount="indefinite" values="0;1;1;0;0" keyTimes="0;0.02;0.32;0.35;1" />
              </g>
              <g class="ferry"><g transform="scale(1.6)">
                <path d="M-13 2 L13 2 L10.5 6.5 L-10.5 6.5 Z" class="hull" />
                <rect x="-9.5" y="-4" width="19" height="6" class="deck" />
                <path d="M-8 -1 h16" class="windows" />
                <rect x="-2.2" y="-8" width="4.4" height="4" class="deck" />
              </g>
                <animateMotion dur="26s" repeatCount="indefinite" rotate="0" keyPoints="0;1;1;0;0" keyTimes="0;0.42;0.5;0.92;1" calcMode="linear"><mpath href="#ferryRoute" /></animateMotion>
              </g>
              <g class="tram"><g transform="scale(1.6)">
                <rect x="-8" y="-11" width="16" height="13" rx="1.5" class="tram-body" />
                <path d="M-6 -8 h12 M-6 -3 h12" class="tram-win" />
                <circle cx="-4.5" cy="3.2" r="1.5" class="wheel" /><circle cx="4.5" cy="3.2" r="1.5" class="wheel" />
              </g>
                <animateMotion dur="44s" repeatCount="indefinite" rotate="0" keyPoints="0;1;0" keyTimes="0;0.5;1" calcMode="linear"><mpath href="#tramRoute" /></animateMotion>
              </g>
              <g class="junk"><g transform="scale(1.6)">
                <path d="M-12 3 Q0 8 12 3 L14 0 L-14 0 Z" class="junk-hull" />
                <path d="M-6 0 L-6 -15 Q-12 -8 -11 0 Z" class="sail" />
                <path d="M4 0 L4 -19 Q-4 -10 -3 0 Z" class="sail" />
                <path d="M-10.5 -4 h4.5 M-11 -9 h5 M-3 -6 h7 M-2 -12 h6" class="batten" />
              </g>
                <animateMotion dur="80s" repeatCount="indefinite" rotate="0" keyPoints="0;1;0" keyTimes="0;0.5;1" calcMode="linear"><mpath href="#junkRoute" /></animateMotion>
              </g>
            </g>
          </svg>
          <svg class="overlay" id="overlay" aria-hidden="true"><g id="leaders"></g><path id="string" class="string" /></svg>
          {cards.map((p, i) => (
            <button class={`pin${p.approx ? " approx" : ""}`} type="button" data-i={i} style={`left:${pct[i][0]}%;top:${pct[i][1]}%`}
              aria-label={`Scene ${p.n}: ${p.en}`}>
              <span class="head"><span class="num">{p.n}</span></span>
              <span class={`placard k-${p.kind}`}><b>{p.zh}</b><small>{p.en}</small></span>
            </button>
          ))}
        </div>
        <div class="wx" id="wx" aria-hidden="true"></div>
      </div>
      <svg class="inset" viewBox={`0 0 ${inset.w} ${inset.h}`} aria-hidden="true">
        <rect width={inset.w} height={inset.h} class="inset-bg" />
        <path d={inset.d} class="inset-land" />
        <rect x={inset.frame[0]} y={inset.frame[1]} width={inset.frame[2]} height={inset.frame[3]} class="inset-frame" />
        <text x="6" y="12" class="inset-t">HONG KONG · 香港</text>
      </svg>
      <button class="zoom-out" id="zoomOut" type="button" hidden>← Wide shot</button>
    </div>

    <nav class="strip" id="strip" aria-label="Scenes">
      <ol>
        {cards.map((p, i) => (
          <li><button class="frame" type="button" data-i={i}>
            <span class="f-n">{p.n}</span><span class="f-zh">{p.zh.split(" · ")[0]}</span>
            <span class="sr">{p.slug}. {p.en}.{p.note?.zh ? ` ${p.note.zh}.` : ""}{p.note?.en ? ` ${p.note.en}` : ""}</span>
          </button></li>
        ))}
      </ol>
    </nav>

    <aside class="scene" id="scene" hidden aria-live="polite">
      <button class="scene-x" id="sceneClose" type="button" aria-label="Close scene">✕</button>
      <p class="scene-no" id="sceneNo"></p>
      <p class="scene-slug" id="sceneSlug"></p>
      <h2 class="scene-zh" id="sceneZh"></h2>
      <p class="scene-en" id="sceneEn"></p>
      <p class="scene-meta" id="sceneMeta"></p>
      <div class="screen" id="screen"><p class="sub-zh" id="subZh"></p><p class="sub-en" id="subEn"></p></div>
      <div class="scene-nav"><button type="button" id="prevScene">← Prev</button><button type="button" id="nextScene">Next →</button></div>
    </aside>
  </div>

  <p class="credits">Coastline © OpenStreetMap contributors (ODbL). District boundaries: Home Affairs Department, HKSAR, via DATA.GOV.HK. Drawn and simplified for this page; not for navigation.</p>

  <script is:inline define:vars={{ cards, pts, W, H }}>
  (() => {
    const scout = document.getElementById("scout"), viewport = document.getElementById("viewport"), stage = document.getElementById("stage");
    const overlay = document.getElementById("overlay"), stringPath = document.getElementById("string"), leaders = document.getElementById("leaders");
    const pins = [...stage.querySelectorAll(".pin")], scene = document.getElementById("scene"), zoomOut = document.getElementById("zoomOut");
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let active = -1, zoom = 1, pos = [];

    // pin heads stay a constant on-screen size; nudge apart any that would overlap and draw a leader to the true spot
    function layout() {
      const w = viewport.clientWidth, h = viewport.clientHeight;
      overlay.setAttribute("viewBox", `0 0 ${w} ${h}`);
      const truth = pts.map(([x, y]) => [x / W * w, y / H * h]);
      pos = truth.map(p => p.slice());
      const min = (w < 520 ? 22 : 28) / zoom;
      for (let it = 0; it < 80; it++) {
        for (let i = 0; i < pos.length; i++) for (let j = i + 1; j < pos.length; j++) {
          let dx = pos[j][0] - pos[i][0], dy = pos[j][1] - pos[i][1], d = Math.hypot(dx, dy) || 0.01;
          if (d < min) { const push = (min - d) / 2; dx /= d; dy /= d; pos[i][0] -= dx * push; pos[i][1] -= dy * push; pos[j][0] += dx * push; pos[j][1] += dy * push; }
        }
        pos.forEach((p, i) => { p[0] += (truth[i][0] - p[0]) * 0.04; p[1] += (truth[i][1] - p[1]) * 0.04; });
      }
      pins.forEach((el, i) => {
        el.style.left = pos[i][0] + "px"; el.style.top = pos[i][1] + "px";
        el.style.setProperty("--z", zoom);
      });
      leaders.innerHTML = truth.map((t, i) => Math.hypot(t[0] - pos[i][0], t[1] - pos[i][1]) > 3
        ? `<line x1="${t[0]}" y1="${t[1]}" x2="${pos[i][0]}" y2="${pos[i][1]}" class="leader"/><circle cx="${t[0]}" cy="${t[1]}" r="${2.2 / zoom}" class="leader-dot"/>` : "").join("");
      // red string, sagging a little between pins
      let d = `M${pos[0][0]} ${pos[0][1]}`;
      for (let i = 1; i < pos.length; i++) {
        const [ax, ay] = pos[i - 1], [bx, by] = pos[i], sag = Math.min(40, Math.hypot(bx - ax, by - ay) * 0.12) / zoom;
        d += ` Q${(ax + bx) / 2} ${(ay + by) / 2 + sag} ${bx} ${by}`;
      }
      stringPath.setAttribute("d", d);
      stringPath.style.strokeWidth = (2 / zoom) + "px";
    }

    function camera(i) {
      const w = viewport.clientWidth, h = viewport.clientHeight;
      if (i < 0) { zoom = 1; stage.style.transform = "none"; }
      else {
        zoom = w < 520 ? 2.6 : 2.2;
        const [x, y] = pos[i];
        const tx = Math.min(0, Math.max(w - w * zoom, w / 2 - x * zoom)), ty = Math.min(0, Math.max(h - h * zoom, h / 2 - y * zoom));
        stage.style.transform = `translate(${tx}px, ${ty}px) scale(${zoom})`;
      }
      scout.classList.toggle("zoomed", i >= 0);
      zoomOut.hidden = i < 0;
      layout();
    }

    const set = (id, v) => { document.getElementById(id).textContent = v || ""; };
    function open(i) {
      if (active === i) return;
      active = i;
      const c = cards[i];
      pins.forEach((p, j) => p.classList.toggle("on", j === i));
      frames.forEach((f, j) => { f.classList.toggle("on", j === i); f.setAttribute("aria-current", j === i ? "true" : "false"); });
      frames[i].scrollIntoView({ behavior: reduced ? "auto" : "smooth", block: "nearest", inline: "center" });
      set("sceneNo", `Scene ${c.n} / ${String(cards.length).padStart(2, "0")}`);
      set("sceneSlug", c.slug);
      set("sceneZh", c.zh); set("sceneEn", c.en === c.zh ? "" : c.en);
      set("sceneMeta", [c.kindLabel, c.when, c.approx ? "approximate area" : ""].filter(Boolean).join(" · "));
      set("subZh", c.note?.zh); set("subEn", c.note?.en);
      document.getElementById("screen").classList.toggle("empty", !(c.note?.zh || c.note?.en));
      scene.hidden = false;
      scout.classList.toggle("fw-on", i === fwScene);
      camera(i);
    }
    function close() {
      active = -1; scene.hidden = true; scout.classList.remove("fw-on"); pins.forEach(p => p.classList.remove("on")); frames.forEach(f => { f.classList.remove("on"); f.setAttribute("aria-current", "false"); }); camera(-1);
    }
    pins.forEach((el, i) => el.addEventListener("click", () => (active === i ? close() : open(i))));
    const frames = [...document.querySelectorAll("#strip .frame")];
    frames.forEach(b => b.addEventListener("click", () => (active === +b.dataset.i ? close() : open(+b.dataset.i))));
    document.getElementById("sceneClose").addEventListener("click", close);
    zoomOut.addEventListener("click", close);
    document.getElementById("prevScene").addEventListener("click", () => open((active - 1 + cards.length) % cards.length));
    document.getElementById("nextScene").addEventListener("click", () => open((active + 1) % cards.length));
    addEventListener("keydown", e => {
      if (scene.hidden) return;
      if (e.key === "Escape") close();
      if (e.key === "ArrowRight") open((active + 1) % cards.length);
      if (e.key === "ArrowLeft") open((active - 1 + cards.length) % cards.length);
    });
    addEventListener("resize", () => camera(active));
    // Wan Chai fireworks also go off (by day) while that scene is open
    const fwScene = cards.findIndex(c => /Wan Chai/.test(c.en));

    // Hong Kong right now: local time + live weather (Open-Meteo, no key, no visitor data sent)
    const tEl = document.getElementById("hkTime"), wEl = document.getElementById("hkWx"), wx = document.getElementById("wx");
    const hkt = new Intl.DateTimeFormat("en-GB", { timeZone: "Asia/Hong_Kong", hour: "2-digit", minute: "2-digit" });
    const tick = () => { tEl.textContent = hkt.format(new Date()); };
    tick(); setInterval(tick, 20000);
    const WX = c => c === 0 ? ["晴", "CLEAR"] : c <= 2 ? ["天晴", "FAIR"] : c === 3 ? ["多雲", "CLOUDY"] : (c === 45 || c === 48) ? ["有霧", "FOG", "fog"]
      : c <= 57 ? ["毛毛雨", "DRIZZLE", "rain"] : c <= 67 ? ["雨", "RAIN", "rain"] : c <= 77 ? ["冷", "COLD"] : c <= 82 ? ["驟雨", "SHOWERS", "rain"]
      : c >= 95 ? ["雷暴", "THUNDER", "storm"] : ["", ""];
    const setWx = (code, temp) => {
      const [zh, en, fx] = WX(code);
      wEl.textContent = `${temp != null ? Math.round(temp) + "°C " : ""}${zh} ${en}`.trim();
      wx.className = "wx" + (fx === "storm" ? " rain storm" : fx ? " " + fx : "");
    };
    const force = new URLSearchParams(location.search).get("wx");     // ?wx=rain|fog|storm to preview
    if (force) setWx(force === "fog" ? 45 : force === "storm" ? 95 : 63, null);
    else fetch("https://api.open-meteo.com/v1/forecast?latitude=22.30&longitude=114.21&current=temperature_2m,weather_code&timezone=Asia%2FHong_Kong")
      .then(r => r.json()).then(d => d.current && setWx(d.current.weather_code, d.current.temperature_2m)).catch(() => {});
    if (reduced) document.querySelector(".hkmap").pauseAnimations();
    layout();
    // draw the string in once, the first time the board scrolls into view
    if (!reduced && "IntersectionObserver" in window) {
      const len = stringPath.getTotalLength();
      stringPath.style.strokeDasharray = len; stringPath.style.strokeDashoffset = len;
      new IntersectionObserver((es, ob) => { if (es[0].isIntersecting) { stringPath.classList.add("draw"); ob.disconnect(); setTimeout(() => { stringPath.style.strokeDasharray = ""; stringPath.style.strokeDashoffset = ""; }, 2600); } }, { threshold: 0.3 }).observe(viewport);
    }
  })();
  </script>
</PageLayout>

