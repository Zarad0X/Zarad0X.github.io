    }
    function label(t, y) { ctx.save(); ctx.font = "700 12px 'Courier Prime', monospace"; ctx.textAlign = "center"; ctx.fillStyle = "#fff6e6"; ctx.fillText(t, VW / 2, y); ctx.restore(); }
    function drawHUD() {
