    }
    function drawScore() {
      const x = 16, y = 16, rowH = 30, w = 196;
      ctx.save();
      ctx.fillStyle = C.red; ctx.fillRect(x + 4, y + 4, w, rowH * 2);
      ctx.fillStyle = "#0b0908"; ctx.fillRect(x, y, w, rowH * 2);
      ctx.font = "17px 'Anton', Impact, sans-serif"; ctx.textBaseline = "middle";
      ["HAN", "奶蛙"].forEach((n, i) => {
        const ry = y + rowH * i + rowH / 2;
        ctx.textAlign = "left"; ctx.fillStyle = "#f2e6cc"; ctx.fillText(n, x + 22, ry);
        if (server === i && state !== "over") { ctx.fillStyle = C.yellow; ctx.beginPath(); ctx.arc(x + 10, ry, 4, 0, Math.PI * 2); ctx.fill(); }
        ctx.textAlign = "center"; ctx.fillStyle = "#f2e6cc"; ctx.fillText(games[i], x + 128, ry);
        ctx.fillStyle = C.yellow; ctx.fillRect(x + 148, y + rowH * i + 3, 44, rowH - 6);
        ctx.fillStyle = "#0b0908"; ctx.fillText(state === "over" ? "" : scoreText(i), x + 170, ry + 1);
      });
      ctx.fillStyle = "rgba(0,0,0,.6)"; ctx.fillRect(x, y + rowH * 2 + 8, w, 8);
      ctx.fillStyle = me.stamina > 0.35 ? "#7dffb0" : "#ff6b6b"; ctx.fillRect(x + 1, y + rowH * 2 + 9, (w - 2) * me.stamina, 6);
      ctx.font = "700 9px 'Courier Prime', monospace"; ctx.fillStyle = "#fff6e6"; ctx.textAlign = "left"; ctx.fillText("STAMINA", x + 2, y + rowH * 2 + 24);
      ctx.restore();
    }
    function drawPopups(now) {
      popups.forEach(pp => {
        const age = (now - pp.t) / 1100, p = P(pp.x, pp.y), y = p.y - 90 * p.s - age * 24;
        ctx.save(); ctx.globalAlpha = 1 - age; ctx.font = "16px 'Anton', Impact, sans-serif"; ctx.textAlign = "center";
        ctx.lineWidth = 4; ctx.strokeStyle = "rgba(0,0,0,.8)"; ctx.strokeText(pp.text, p.x, y); ctx.fillStyle = pp.color; ctx.fillText(pp.text, p.x, y); ctx.restore();
      });
    }
    function drawSub(now) {
      if (!subtitle || now > subUntil) return;
      ctx.save(); ctx.font = "700 17px 'Courier Prime', monospace"; ctx.textAlign = "center"; ctx.textBaseline = "middle";
      const text = (subtitle.who ? `[${subtitle.who}] ` : "") + subtitle.text, lines = []; let cur = "";
      for (const word of text.split(" ")) { const t = cur ? cur + " " + word : word; if (ctx.measureText(t).width > VW - 80) { lines.push(cur); cur = word; } else cur = t; }
      lines.push(cur);
      const h = lines.length * 24 + 12, top = VH - 64 - h;
      ctx.fillStyle = "rgba(0,0,0,.8)"; ctx.fillRect(28, top, VW - 56, h);
      lines.forEach((l, i) => { ctx.fillStyle = C.yellow; ctx.fillText(l, VW / 2, top + 18 + i * 24); });
      ctx.restore();
    }

    let last = performance.now(), prevBounces = 0;
    function frame(now) {
      const rdt = Math.min(0.033, (now - last) / 1000); last = now;
      if (state !== "title" && !document.hidden) update(rdt);
      if (ball && ball.bounces > prevBounces && ball.bounces <= 2) marks.push({ x: ball.x, y: ball.y, t: now });
      prevBounces = ball ? ball.bounces : 0;
      while (marks.length && now - marks[0].t > 6000) marks.shift();
      ctx.setTransform(scale * dpr, 0, 0, scale * dpr, 0, 0);
      drawCourt(now);
      const ballFar = ball ? ball.y > NET : false;
      drawFrog();
      if (ballFar) drawBall();
      drawNet();
      if (!ballFar) drawBall();
      drawHan(now);
      drawHUD(); drawScore(); drawPopups(now); drawSub(now);
      requestAnimationFrame(frame);
    }
    stats = freshStats(); placeForPoint(); state = "title";
    requestAnimationFrame(frame);
  })();
  </script>
</PageLayout>

