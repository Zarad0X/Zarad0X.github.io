      ctx.fillStyle = "rgba(0,0,0,.72)"; ctx.fillRect(x0 - 4, y0 - 4, W + 8, H + 8);
      ctx.fillStyle = "#3a312b"; ctx.fillRect(x0, y0, W, H);
