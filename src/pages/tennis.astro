        const type = resolveShot(me.charge.button, chargeOf(me.charge), me.aimY), s = SHOT[type];
        const ty = type === "drop" ? NET + 2.4 : type === "lob" ? LEN - s.depth : LEN - (s.depth + (me.aimY < 0 ? -me.aimY * 3.4 : -me.aimY * 0.9));
        const p = P(me.aimX * 3.85, ty);
        ctx.strokeStyle = C.yellow; ctx.lineWidth = 2; ctx.setLineDash([4, 3]);
        ctx.beginPath(); ctx.ellipse(p.x, p.y, 14 * p.s, 6 * p.s, 0, 0, Math.PI * 2); ctx.stroke(); ctx.setLineDash([]);
        ctx.beginPath(); ctx.moveTo(p.x - 6, p.y); ctx.lineTo(p.x + 6, p.y); ctx.moveTo(p.x, p.y - 4); ctx.lineTo(p.x, p.y + 4); ctx.stroke();
      }
