---
import PageLayout from "@layouts/PageLayout.astro";
---
<PageLayout title="Clay Court" description="A tennis game on clay: Han vs 奶蛙. Charge, time and place every shot. First to three games.">
  <div class="standalone-heading court-heading">
    <span class="kicker">Exhibition match</span>
    <h1>Clay Court</h1>
    <p>Han vs 奶蛙. Charge it, time it, place it. First to three games.</p>
  </div>

  <div class="court-wrap" id="wrap">
    <canvas id="court" tabindex="0" aria-label="Tennis game. Move with WASD or arrow keys. Hold J or Space to charge a drive, K for a touch shot, and release to hit; movement keys aim while charging."></canvas>
    <div class="court-card" id="card">
      <p class="cc-kicker" id="ccKicker">Chapter 15–40</p>
      <h2 class="cc-title" id="ccTitle">Han <span>vs</span> 奶蛙</h2>
      <div class="cc-stats" id="ccStats" hidden></div>
      <div class="cc-levels" role="group" aria-label="Opponent level">
        <button type="button" data-level="0">Amateur</button>
        <button type="button" data-level="1" aria-pressed="true">Pro</button>
        <button type="button" data-level="2">Legend</button>
      </div>
      <button type="button" id="play" class="cc-play">Play ▸</button>
      <p class="cc-tip" id="ccTip">Hold to charge · release when the marker hits green</p>
    </div>
  </div>

  <div class="pad" id="pad" aria-hidden="true">
    <div class="stick" id="stick"><div class="knob" id="knob"></div></div>
    <div class="shots">
      <button type="button" data-shot="drive" class="s-drive">DRIVE<small>hold longer = flat</small></button>
      <button type="button" data-shot="touch" class="s-touch">TOUCH<small>↑ lob · ↓ drop</small></button>
    </div>
  </div>

  <div class="keys">
    <div><b>Move</b> WASD / arrows · <b>Sprint</b> Shift</div>
    <div><b>Drive</b> J or Space — hold to charge (topspin; charge into the red for a flat bomb)</div>
    <div><b>Touch</b> K — slice · with ↑ a lob · with ↓ a drop shot</div>
    <div><b>Aim</b> move keys while charging · <b>Serve</b> hold either, release in the green</div>
  </div>

  <script is:inline>
  (() => {
    // ================================================================ setup
    const canvas = document.getElementById("court"), ctx = canvas.getContext("2d");
    const card = document.getElementById("card"), playBtn = document.getElementById("play");
    const VW = 600, VH = 800, AUTO = /autoplay/.test(location.search);
    let scale = 1, dpr = 1;
    function resize() {
      const w = Math.min(canvas.parentElement.clientWidth, 560);
      dpr = Math.min(2, devicePixelRatio || 1); scale = w / VW;
      canvas.style.width = w + "px"; canvas.style.height = (w * VH / VW) + "px";
      canvas.width = Math.round(w * dpr); canvas.height = Math.round(w * VH / VW * dpr);
    }
    resize(); addEventListener("resize", resize);
    const touch = matchMedia("(hover: none)").matches;
    document.getElementById("pad").hidden = !touch;
    const clamp = (v, a, b) => Math.max(a, Math.min(b, v));
    const gauss = () => { let u = 0, v = 0; while (!u) u = Math.random(); while (!v) v = Math.random(); return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v); };

    // ================================================================ court, in metres
    const HW = 4.115, DW = 5.485, LEN = 23.77, NET = LEN / 2, SVC = 6.40, G = 9.81, R = 0.033;
    const TIME = 0.7;                                         // game seconds per real second: real ball speeds, playable pace
    const netH = x => 0.914 + 0.156 * Math.min(1, Math.abs(x) / 6.4);
    const NEAR_Y = 0.86 * VH, FAR_Y = 0.21 * VH, HALF_NEAR = 0.34 * VW, HALF_FAR = 0.225 * VW;
    const persp = t => t * 1.3 / (1 + 0.3 * t);
    function P(x, y, z = 0) {
      const ty = persp(y / LEN), s = 1 + (HALF_FAR / HALF_NEAR - 1) * ty;
      return { x: VW / 2 + (x / HW) * HALF_NEAR * s, y: NEAR_Y + (FAR_Y - NEAR_Y) * ty - z * 36 * s, s };
    }

    // ================================================================ shots: each has pace, net margin, spin and how it comes off the clay
    const SHOT = {
      topspin: { v: 25, clr: 1.05, spin: 6.5,  e: 0.80, fr: 0.84, depth: 2.6, label: "TOPSPIN" },
      flat:    { v: 31, clr: 0.40, spin: 0.6,  e: 0.70, fr: 0.90, depth: 2.2, label: "FLAT" },
      slice:   { v: 20, clr: 0.55, spin: -3.2, e: 0.52, fr: 0.70, depth: 3.0, label: "SLICE" },
      lob:     { v: 15, clr: 4.4,  spin: 1.2,  e: 0.74, fr: 0.76, depth: 1.6, label: "LOB" },
      drop:    { v: 10, clr: 0.55, spin: -2.0, e: 0.45, fr: 0.52, depth: 0,   label: "DROP SHOT" },
      serve:   { v: 44, clr: 0.25, spin: 1.5,  e: 0.68, fr: 0.86, depth: 0,   label: "SERVE" },
    };
    const LEVELS = [
      { name: "Amateur", speed: 4.4, sigmaT: 0.10, aim: 0.70, read: 0.24, fault: 0.14, attack: 0.10, posNoise: 0.5 },
      { name: "Pro",     speed: 5.2, sigmaT: 0.07, aim: 0.88, read: 0.17, fault: 0.09, attack: 0.16, posNoise: 0.34 },
      { name: "Legend",  speed: 5.9, sigmaT: 0.045, aim: 0.96, read: 0.11, fault: 0.05, attack: 0.26, posNoise: 0.2 },
    ];
    let level = LEVELS[1];

    // ================================================================ ball physics
    let ball = null, simNow = 0;
    function launch(hitter, from, target, type, speedMul, netErr) {
      const s = SHOT[type], dx = target.x - from.x, dy = target.y - from.y, dist = Math.hypot(dx, dy), gEff = G + s.spin;
      let T = dist / (s.v * speedMul);
      const clearance = T0 => {
        const vz = (0.5 * gEff * T0 * T0 - from.z) / T0, tn = (NET - from.y) / (dy / T0);
        return tn > 0 && tn < T0 ? from.z + vz * tn - 0.5 * gEff * tn * tn - netH(from.x + dx * tn / T0) : 9;
      };
      for (let i = 0; i < 40 && clearance(T) < s.clr; i++) T *= 1.05;               // loop it up until it clears with its margin
      T *= 1 - netErr;                                                              // a bad contact flattens the arc
      const vz = (0.5 * gEff * T * T - from.z) / T;
      ball = { x: from.x, y: from.y, z: from.z, vx: dx / T, vy: dy / T, vz, spin: s.spin, type, s, hitter, bounces: 0, netted: false, born: simNow };
      ball.speed = Math.hypot(ball.vx, ball.vy, vz);
      rally.shots++;
    }
    function stepBall(b, dt) {
      const px = b.x, py = b.y, pz = b.z;
      b.vz -= (G + (b.bounces ? b.spin * 0.25 : b.spin)) * dt;
      b.x += b.vx * dt; b.y += b.vy * dt; b.z += b.vz * dt;
      if (!b.netted && b.bounces === 0 && (py - NET) * (b.y - NET) <= 0) {
        const f = (NET - py) / ((b.y - py) || 1e-6), zx = pz + (b.z - pz) * f, xx = px + (b.x - px) * f;
        if (zx < netH(xx) + R) { b.netted = true; b.y = NET - Math.sign(b.vy) * 0.05; b.vx *= 0.1; b.vy *= -0.12; b.vz = Math.min(0, b.vz) * 0.3; return "net"; }
      }
      if (b.z <= R && b.vz < 0) {
        b.z = R; b.vz = -b.vz * (b.bounces ? 0.5 : b.s.e); b.vx *= b.s.fr; b.vy *= b.s.fr; b.bounces++;
        if (b.vz < 0.4) b.vz = 0;
        return "bounce";
      }
      return null;
    }
    // when does the ball reach a player's hitting plane? (after the bounce, or before it for a volley)
    function predict(b, plane, allowVolley) {
      const c = { ...b }; let t = 0;
      for (let i = 0; i < 700; i++) {
        if (stepBall(c, 0.005) === "net") return null;
        t += 0.005;
        const crossed = c.vy < 0 ? c.y <= plane : c.y >= plane;
        if (crossed && (c.bounces >= 1 || (allowVolley && c.z > 0.25))) return { t, x: c.x, y: c.y, z: c.z, volley: c.bounces === 0 };
        if (c.bounces >= 2) return { t: Math.max(0, t - 0.1), x: c.x, y: c.y, z: c.z, late: true };
      }
      return null;
    }

    // ================================================================ players
    const mk = near => ({ near, x: 0, y: near ? -0.6 : LEN + 0.6, vx: 0, vy: 0, tx: 0, ty: 0, stamina: 1, swing: 0, side: 1, charge: null, aimX: 0, aimY: 0, plan: null, pending: null });
    const me = mk(true), op = mk(false), players = [me, op];
    const contactPlane = p => p.near ? p.y + 0.45 : p.y - 0.45;
    const canVolley = p => p.near ? p.y > NET - SVC - 0.5 : p.y < NET + SVC + 0.5;

    // ================================================================ match state
    let state = "title";                                   // title | serve | rally | point | over
    let games = [0, 0], pts = [0, 0], server = 0, secondServe = false, faultPending = false;
    let serveMeter = null, cpuServeAt = 0, pointEndAt = 0, rally = { shots: 0 };
    let stats, popups = [], subtitle = null, subUntil = 0, matchPointsSaved = 0, wasDown02 = false;
    const freshStats = () => ({ winners: [0, 0], ue: [0, 0], aces: [0, 0], dfs: [0, 0], perfect: 0, swings: 0, fastest: 0, longest: 0 });
    const say = (who, text, ms = 1700) => { subtitle = { who, text }; subUntil = performance.now() + ms; };
    const pop = (text, x, y, color = "#f6c400") => popups.push({ text, x, y, color, t: performance.now() });

    function placeForPoint() {
      const deuce = (pts[0] + pts[1]) % 2 === 0, nearSide = deuce ? 1 : -1, farSide = -nearSide;   // near player's right is +x, far player's is −x
      if (server === 0) { me.x = 0.9 * nearSide; me.y = -0.5; op.x = 2.6 * farSide; op.y = LEN + 1.2; }
      else { op.x = 0.9 * farSide; op.y = LEN + 0.5; me.x = 2.6 * nearSide; me.y = -1.2; }
      players.forEach(p => { p.vx = p.vy = 0; p.tx = p.x; p.ty = p.y; p.charge = null; p.plan = null; p.pending = null; p.swing = 0; p.stamina = Math.min(1, p.stamina + 0.18); });
      ball = null; serveMeter = null; rally = { shots: 0 }; me.auto = null;
      state = "serve";
      if (server === 1) cpuServeAt = simNow + (secondServe ? 0.7 : 1.0);
    }
    function endPoint(winner, why, kind) {
      if (state !== "rally" && state !== "serve") return;
      state = "point"; pointEndAt = simNow + 1.0; faultPending = false;
      const loser = 1 - winner;
      if (kind === "winner") stats.winners[winner]++;
      if (kind === "ue") stats.ue[loser]++;
      if (kind === "ace") stats.aces[winner]++;
      if (kind === "df") stats.dfs[loser]++;
      stats.longest = Math.max(stats.longest, rally.shots);
      if (games[1] === 2 && pts[1] >= 3 && pts[1] > pts[0] && winner === 0) matchPointsSaved++;
      pts[winner]++; secondServe = false;
      let line = why;
      if (pts[winner] >= 4 && pts[winner] - pts[loser] >= 2) {
        games[winner]++; pts = [0, 0]; server = 1 - server;
        if (games[0] === 0 && games[1] === 2) wasDown02 = true;
        if (games[winner] === 3) return finish(winner);
        line = `${why ? why + " " : ""}Game, ${winner === 0 ? "Han" : "奶蛙"}.`;
      } else if (pts[0] >= 3 && pts[1] >= 3) {
        line = `${why ? why + " " : ""}${pts[0] === pts[1] ? "Deuce." : `Advantage, ${pts[0] > pts[1] ? "Han" : "奶蛙"}.`}`;
      }
      if (line) say("COMMENTATOR", line, 1600);
    }
    function fault(text) {
      if (secondServe) return endPoint(1 - server, "Double fault.", "df");
      secondServe = true; faultPending = true; say("UMPIRE", text, 1100);
      state = "point"; pointEndAt = simNow + 0.9;
    }
    function finish(winner) {
      state = "over";
      const comeback = winner === 0 && wasDown02, saved = winner === 0 && matchPointsSaved > 0;
      say("COMMENTATOR", winner === 0
        ? (comeback && saved ? `From 0–2 down, ${matchPointsSaved} match point${matchPointsSaved > 1 ? "s" : ""} saved. Roland-Garros 2025 energy.`
          : comeback ? "From two games down. Pure Alcaraz." : saved ? "Match point saved — and then the match." : "Game, set and match, Han.")
        : "Game, set and match, 奶蛙. The horse stance holds.", 4200);
      setTimeout(showEnd, 1800);
    }
    function scoreText(i) {
      const a = pts[i], b = pts[1 - i];
      if (a >= 3 && b >= 3) return a === b ? "40" : a > b ? "AD" : "40";
      return ["0", "15", "30", "40"][Math.min(a, 3)];
    }

    // ================================================================ input: two shot buttons
    //   DRIVE (J / Space): topspin; charge past 85% for a flat bomb
    //   TOUCH (K): slice; with ↑ a lob, with ↓ a drop shot
    const keys = new Set(); let stick = { x: 0, y: 0, active: false };
    const SHOT_KEYS = { j: "drive", " ": "drive", k: "touch" };
    addEventListener("keydown", e => {
      if (state === "title" || state === "over") return;
      const k = e.key.length === 1 ? e.key.toLowerCase() : e.key;
      if (["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown", " "].includes(e.key)) e.preventDefault();
      if (SHOT_KEYS[k]) { if (!e.repeat) press(SHOT_KEYS[k]); } else keys.add(k);
    });
    addEventListener("keyup", e => { const k = e.key.length === 1 ? e.key.toLowerCase() : e.key; if (SHOT_KEYS[k]) release(SHOT_KEYS[k]); keys.delete(k); });
    function moveInput() {
      let x = (keys.has("ArrowRight") || keys.has("d") ? 1 : 0) - (keys.has("ArrowLeft") || keys.has("a") ? 1 : 0);
      let y = (keys.has("ArrowUp") || keys.has("w") ? 1 : 0) - (keys.has("ArrowDown") || keys.has("s") ? 1 : 0);
      if (stick.active) { x = stick.x; y = stick.y; }
      return { x, y, sprint: keys.has("Shift") || (stick.active && Math.hypot(stick.x, stick.y) > 0.92) };
    }
    const stickEl = document.getElementById("stick"), knob = document.getElementById("knob");
    function moveStick(e) {
      const r = stickEl.getBoundingClientRect(), rad = r.width / 2;
      let dx = (e.clientX - r.left - rad) / rad, dy = (r.top + rad - e.clientY) / rad; const m = Math.hypot(dx, dy); if (m > 1) { dx /= m; dy /= m; }
      stick.x = dx; stick.y = dy; knob.style.transform = `translate(${dx * rad * 0.6}px, ${-dy * rad * 0.6}px)`;
    }
    const capture = (el, e) => { try { el.setPointerCapture(e.pointerId); } catch (_) {} };
    stickEl.addEventListener("pointerdown", e => { stick.active = true; moveStick(e); capture(stickEl, e); });
    stickEl.addEventListener("pointermove", e => { if (stick.active) moveStick(e); });
    const endStick = () => { stick = { x: 0, y: 0, active: false }; knob.style.transform = ""; };
    stickEl.addEventListener("pointerup", endStick); stickEl.addEventListener("pointercancel", endStick);
    document.querySelectorAll(".shots button").forEach(b => {
      b.addEventListener("pointerdown", e => { e.preventDefault(); b.classList.add("down"); if (state !== "title" && state !== "over") press(b.dataset.shot); capture(b, e); });
      const up = () => { b.classList.remove("down"); release(b.dataset.shot); };
      b.addEventListener("pointerup", up); b.addEventListener("pointercancel", up);
    });

    const chargeOf = c => clamp((simNow - c.t0) / 0.75, 0, 1.25);
    function resolveShot(button, charge, aimY) {
      if (button === "drive") return charge >= 0.85 ? "flat" : "topspin";
      return aimY > 0.5 ? "lob" : aimY < -0.5 ? "drop" : "slice";
    }
    function press(button) {
      if (state === "serve" && server === 0 && !serveMeter) { serveMeter = { t0: simNow }; me.charge = { button, t0: simNow }; return; }
      if (state !== "rally" || me.charge) return;
      me.charge = { button, t0: simNow };
    }
    function release(button) {
      if (!me.charge || me.charge.button !== button) return;
      if (state === "serve" && serveMeter) { me.charge = null; return doServe(me, meterValue(), me.aimX); }
      const c = chargeOf(me.charge); me.charge = null;
      swing(me, resolveShot(button, c, me.aimY), c, simNow);
    }
    const meterValue = () => { const t = (simNow - serveMeter.t0) / 1.0; return t <= 1 ? t : Math.max(0, 2 - t); };

    // ================================================================ hitting
    function swing(p, type, power, releaseAt) {
      p.swing = 1;
      if (!ball || ball.hitter === players.indexOf(p) || ball.netted) return;
      const pr = predict(ball, contactPlane(p), canVolley(p));
      if (!pr) return;
      const err = releaseAt - (simNow + pr.t);                                         // < 0 early, > 0 late
      if (err < -0.24) { if (p === me) pop("TOO EARLY", p.x, p.y, "#ff6b6b"); return; }
      // early releases wait for the ball; late ones (the ball is already here) hit now
      p.pending = { type, power, err: clamp(err, -0.24, 0.24), at: simNow + pr.t };
    }
    function execute(p) {
      const pd = p.pending; p.pending = null;
      const who = players.indexOf(p);
      if (!ball || ball.hitter === who || ball.netted) return;
      const lat = ball.x - p.x, depthOff = ball.y - contactPlane(p);
      if (Math.abs(lat) > 1.75 || Math.abs(depthOff) > 1.0 || ball.z > 2.7) { if (p === me) pop("MISSED", p.x, p.y, "#ff6b6b"); return; }
      p.side = lat >= 0 ? 1 : -1; p.swing = 1;
      // ---- quality: timing × position × contact height × stamina × incoming pace
      const e = Math.abs(pd.err);
      const timing = e < 0.045 ? 1 : e < 0.11 ? 0.86 : e < 0.17 ? 0.66 : 0.42;
      const al = Math.abs(lat), pos = al < 0.3 ? 0.62 : al < 0.55 ? 0.85 : al <= 1.2 ? 1 : al <= 1.5 ? 0.78 : 0.55;
      let type = pd.type;
      const volley = ball.bounces === 0;
      if (volley && type !== "lob" && type !== "drop") type = "flat";
      const h = ball.z, height = h < 0.35 ? (type === "slice" ? 0.85 : 0.65) : h <= 1.4 ? 1 : h <= 1.9 ? 0.85 : 0.7;
      const pace = clamp(1.08 - (Math.hypot(ball.vx, ball.vy) - 18) / 60, 0.78, 1);
      const q = timing * pos * height * (0.7 + 0.3 * p.stamina) * pace;
      if (p === me) { stats.swings++; if (timing === 1) stats.perfect++; }
      // ---- target, in world coordinates
      const dir = p.near ? 1 : -1, baseline = p.near ? LEN : 0, s = SHOT[type];
      let tx = p.aimX * 3.85, ty;
      if (type === "drop") ty = NET + dir * 2.4;
      else if (type === "lob") ty = baseline - dir * s.depth;
      else ty = baseline - dir * (s.depth + (p.aimY < 0 ? -p.aimY * 3.4 : -p.aimY * 0.9));
      tx += clamp(pd.err / 0.2, -1.2, 1.2) * 1.5 * p.side * dir;                         // early pulls, late pushes
      // ---- error: spread grows with bad quality, raw power and risky targets
      const power = Math.min(1, pd.power), over = Math.max(0, pd.power - 1);
      const spread = (1 - q) * 2.4 + power * 0.35 + over * 2.2 + Math.max(0, Math.abs(tx) - 2.6) * 0.6;
      tx += gauss() * spread * 0.75; ty += gauss() * spread * 0.9;
      const netErr = Math.max(0, gauss() * (1 - q) * 0.16 + (type === "flat" ? 0.02 : 0));
      const speedMul = (0.82 + 0.38 * power) * (0.85 + 0.15 * q);
      p.stamina = Math.max(0, p.stamina - 0.012 - power * 0.02);
      launch(who, { x: ball.x, y: ball.y, z: clamp(ball.z, 0.5, 2.2) }, { x: tx, y: ty }, type, speedMul, netErr);
      if (p === me) {
        const tag = timing === 1 ? "PERFECT" : timing > 0.8 ? "GOOD" : pd.err < 0 ? "EARLY" : "LATE";
        pop(`${tag} · ${volley ? "VOLLEY" : s.label}`, p.x, p.y, timing === 1 ? "#7dffb0" : timing > 0.8 ? "#f6c400" : "#ff9a5c");
      }
      players[1 - who].plan = null;
    }
    function doServe(p, meter, aim) {
      const who = players.indexOf(p), deuce = (pts[0] + pts[1]) % 2 === 0, dir = p.near ? 1 : -1;
      const boxSign = p.near ? (deuce ? -1 : 1) : (deuce ? 1 : -1);                    // the box diagonal from the server
      let tx = boxSign * 1.95 + clamp(aim, -1, 1) * 1.6;                                // ← → picks wide / body / T
      let ty = NET + dir * (SVC - 0.7);
      const sweet = meter >= 0.8 && meter <= 0.92, off = sweet ? 0 : meter > 0.92 ? (meter - 0.92) * 7 : (0.8 - meter) * 1.2;
      const spread = (secondServe ? 0.35 : 0.55) + off * 0.9;
      tx += gauss() * spread; ty += dir * (gauss() * spread * 0.8 + (meter > 0.92 ? (meter - 0.92) * 6 : 0));
      const speedMul = secondServe ? 0.62 + 0.12 * meter : 0.68 + 0.42 * Math.min(1, meter);
      p.swing = 1; p.side = 1;
      launch(who, { x: p.x, y: p.y + dir * 0.3, z: 2.75 }, { x: tx, y: ty }, "serve", speedMul, secondServe ? 0 : Math.max(0, gauss() * 0.04));
      ball.serve = true; ball.boxSign = boxSign;
      const kmh = Math.round(ball.speed * 3.6);
      if (p === me) { stats.fastest = Math.max(stats.fastest, kmh); pop(`${sweet ? "PERFECT · " : ""}${kmh} KM/H`, p.x, p.y, sweet ? "#7dffb0" : "#f6c400"); }
      serveMeter = null; state = "rally";
    }

    // ================================================================ 奶蛙: same physics, same error model
    function aiThink(p) {
      const who = players.indexOf(p);
      if (!ball || ball.netted) return;
      if (ball.hitter === who) { p.tx = clamp(-ball.x * 0.25, -1.2, 1.2); p.ty = LEN + 0.9; p.plan = null; return; }   // recover
      if (simNow - ball.born < level.read) return;                                       // reaction time
      if (!p.plan) {
        const standY = LEN + 0.8;
        let pr = predict(ball, standY - 0.45, false);
        if (!pr || pr.late) {                                                            // short ball: come in for it
          const c = { ...ball }; let t = 0;
          for (let i = 0; i < 700; i++) { stepBall(c, 0.005); t += 0.005; if (c.bounces >= 1 && c.vz < 0 && c.z < 1.1) break; }
          pr = { t, x: c.x, y: c.y, z: c.z };
        }
        const off = pr.x >= p.x ? -0.85 : 0.85;                                          // keep the ball at arm's length
        const hanAtNet = me.y > NET - SVC - 0.5, stretched = Math.abs(pr.x - p.x) > 2.6;
        let type = "topspin";
        if (hanAtNet && Math.random() < 0.45) type = "lob";
        else if (stretched) type = Math.random() < 0.7 ? "slice" : "topspin";
        else if (pr.y < LEN - 5 || Math.random() < level.attack || Math.abs(me.x) > 2.6) type = "flat";
        else if (Math.random() < 0.12) type = "slice";
        if (type === "slice" && me.y < 1 && Math.random() < 0.15) type = "drop";
        const open = me.x > 0 ? -1 : 1;                                                  // aim away from Han
        p.aimX = clamp(open * level.aim * (0.7 + Math.random() * 0.4) + gauss() * 0.12, -1, 1);
        p.aimY = Math.random() < 0.7 ? 0.35 : -0.2;
        p.plan = { at: simNow + pr.t, x: pr.x + off + gauss() * level.posNoise, y: pr.y + 0.45, type };   // nobody arrives perfectly
      }
      p.tx = p.plan.x; p.ty = clamp(p.plan.y, NET + 1.5, LEN + 3);
      if (!p.pending && !p.plan.done && simNow >= p.plan.at - 0.25) {
        const pr = predict(ball, contactPlane(p), canVolley(p));
        if (pr) { p.pending = { type: p.plan.type, power: 0.55 + Math.random() * 0.4, err: clamp(gauss() * level.sigmaT, -0.2, 0.2), at: simNow + pr.t }; p.plan.done = true; }
      }
    }
    function aiServe(p) {
      const aim = Math.random() * 2 - 1;
      if (Math.random() < level.fault * (secondServe ? 0.25 : 1)) doServe(p, 0.97 + Math.random() * 0.05, aim);
      else doServe(p, secondServe ? 0.6 + Math.random() * 0.2 : 0.8 + Math.random() * 0.12, aim);
    }

    // ================================================================ autoplay test harness: Han plays himself
    function autoplay() {
      if (state === "serve" && server === 0) {
        if (!serveMeter) press("drive");
        else { me.aimX = Math.random() * 2 - 1; if (meterValue() > 0.84) release("drive"); }
        return;
      }
      if (state !== "rally" || !ball || ball.hitter === 0 || ball.netted) { me.auto = null; return; }
      const pr = predict(ball, contactPlane(me), false); if (!pr) return;
      if (!me.auto) me.auto = { button: Math.random() < 0.8 ? "drive" : "touch", aimX: Math.random() * 1.6 - 0.8, aimY: Math.random() < 0.8 ? 0 : -0.2, hold: 0.3 + Math.random() * 0.5 };
      me.autoTarget = pr.x - (pr.x >= me.x ? 0.85 : -0.85);
      if (!me.charge && pr.t < me.auto.hold && pr.t > 0.05) press(me.auto.button);
      if (me.charge) { me.aimX = me.auto.aimX; me.aimY = me.auto.aimY; }
      if (me.charge && pr.t < 0.02) release(me.auto.button);
    }

    // ================================================================ simulation
    function movePlayer(p, dt, ix, iy, sprint, maxSpeed) {
      const sp = maxSpeed * (sprint && p.stamina > 0.1 ? 1.25 : 1) * (0.75 + 0.25 * p.stamina);
      const m = Math.max(1, Math.hypot(ix, iy)), a = 22 * dt;
      p.vx += clamp(ix / m * sp - p.vx, -a, a); p.vy += clamp(iy / m * sp - p.vy, -a, a);
      p.x += p.vx * dt; p.y += p.vy * dt;
      p.stamina = sprint && Math.hypot(ix, iy) > 0.2 ? Math.max(0, p.stamina - 0.05 * dt) : Math.min(1, p.stamina + 0.03 * dt);
    }
    function update(rdt) {
      const dt = rdt * TIME; simNow += dt;
      if (AUTO) autoplay();
      // ---- Han: move, or (while charging) aim — with a little automatic footwork toward the ball
      const inp = moveInput();
      if (me.charge) {
        if (!AUTO) { me.aimX = clamp(inp.x, -1, 1); me.aimY = clamp(inp.y, -1, 1); }
        if (ball && state === "rally" && ball.hitter === 1 && !ball.netted) {
          const pr = predict(ball, contactPlane(me), canVolley(me));
          if (pr) { const want = pr.x - (pr.x >= me.x ? 0.85 : -0.85); movePlayer(me, dt, clamp((want - me.x) * 2, -1, 1) * 0.6, 0, false, 5); }
        }
      } else if (state === "serve" && server === 0) { /* set to serve */ }
      else if (AUTO && state === "rally" && me.autoTarget != null) movePlayer(me, dt, clamp((me.autoTarget - me.x) * 2, -1, 1), clamp((-0.6 - me.y) * 2, -1, 1), true, 5.2);
      else movePlayer(me, dt, inp.x, inp.y, inp.sprint, 5.2);
      me.x = clamp(me.x, -DW - 0.6, DW + 0.6); me.y = clamp(me.y, -4, NET - 0.6);
      // ---- 奶蛙
      if (state === "rally") aiThink(op);
      if (state === "serve" && server === 1 && simNow > cpuServeAt) aiServe(op);
      if (state === "rally" || state === "point") movePlayer(op, dt, clamp((op.tx - op.x) * 1.6, -1, 1), clamp((op.ty - op.y) * 1.6, -1, 1), Math.abs(op.tx - op.x) > 2, level.speed);
      op.x = clamp(op.x, -DW - 0.6, DW + 0.6); op.y = clamp(op.y, NET + 0.6, LEN + 4);
      players.forEach(p => { p.swing = Math.max(0, p.swing - rdt * 4); if (p.pending && simNow >= p.pending.at) execute(p); });
      // ---- the ball
      if (ball) {
        for (let i = 0; i < 4 && ball; i++) {
          const ev = stepBall(ball, dt / 4);
          if (state !== "rally") continue;
          const hitter = ball.hitter, recv = 1 - hitter;
          if (ev === "net") { if (ball.serve) fault("Net. Second serve."); else endPoint(recv, "Into the net.", "ue"); continue; }
          if (ev === "bounce" && ball.bounces === 1) {
            const inX = Math.abs(ball.x) <= HW + R, inY = hitter === 0 ? ball.y >= NET && ball.y <= LEN + R : ball.y <= NET && ball.y >= -R;
            if (ball.serve) {
              const boxY = hitter === 0 ? ball.y <= NET + SVC + R : ball.y >= NET - SVC - R;
              const boxX = ball.boxSign > 0 ? ball.x >= -R && ball.x <= HW + R : ball.x <= R && ball.x >= -HW - R;
              if (!(inY && boxY && boxX)) { pop("FAULT", ball.x, ball.y, "#ff6b6b"); fault("Fault."); continue; }
            } else if (!(inX && inY)) { pop("OUT", ball.x, ball.y, "#ff6b6b"); endPoint(recv, Math.abs(ball.x) > HW + R ? "Wide." : "Long.", "ue"); continue; }
          }
          if (ev === "bounce" && ball.bounces === 2) {
            if (ball.serve && rally.shots === 1) endPoint(hitter, "Ace.", "ace");
            else endPoint(hitter, hitter === 0 ? "Winner." : "", "winner");
            continue;
          }
          if (Math.abs(ball.x) > DW + 6 || ball.y < -9 || ball.y > LEN + 9) endPoint(hitter, "", "winner");
        }
      }
      if (state === "point" && simNow > pointEndAt) placeForPoint();
      popups = popups.filter(p => performance.now() - p.t < 1100);
      if (AUTO) window.__tennis = { state, games: games.slice(), pts: pts.slice(), server, stats, level: level.name };
    }

