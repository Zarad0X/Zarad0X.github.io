      ctx.fillText("C O U R T   P H I L I P P E - Z H A N G", VW / 2, FAR_Y - 47);
      for (let i = 0; i < 14; i++) { const y0 = i / 14 * LEN, y1 = (i + 1) / 14 * LEN; quad(P(-DW - 0.8, y0), P(DW + 0.8, y0), P(DW + 0.8, y1), P(-DW - 0.8, y1), i % 2 ? C.clay : C.clayDark); }
      const g = ctx.createLinearGradient(0, FAR_Y - 40, 0, VH);
      g.addColorStop(0, "rgba(40,10,0,.34)"); g.addColorStop(.45, "rgba(40,10,0,.06)"); g.addColorStop(1, "rgba(255,230,190,.10)");
      ctx.fillStyle = g; ctx.fillRect(0, FAR_Y - 40, VW, VH);
      const v = ctx.createRadialGradient(VW / 2, VH * 0.6, VW * 0.25, VW / 2, VH * 0.6, VW * 0.85);
      v.addColorStop(0, "rgba(0,0,0,0)"); v.addColorStop(1, "rgba(30,6,0,.35)"); ctx.fillStyle = v; ctx.fillRect(0, 0, VW, VH);
      marks.forEach(m => { const p = P(m.x, m.y), a = 0.4 * (1 - (now - m.t) / 6000); ctx.fillStyle = `rgba(110,35,8,${a})`; ctx.beginPath(); ctx.ellipse(p.x, p.y, 6 * p.s, 2.4 * p.s, 0, 0, Math.PI * 2); ctx.fill(); });
      ctx.lineCap = "round";
      ctx.save(); ctx.translate(1.5, 2); ctx.strokeStyle = "rgba(60,15,0,.35)"; courtLines(); ctx.restore();
      ctx.strokeStyle = C.line; courtLines();
    }
    function drawNet() {
      const L = -DW - 0.9, Rr = DW + 0.9, a = P(L, NET), b = P(Rr, NET), top = [];
      for (let i = 0; i <= 20; i++) { const x = L + (Rr - L) * i / 20; top.push(P(x, NET, netH(x))); }
      ctx.beginPath(); ctx.moveTo(a.x, a.y); top.forEach(p => ctx.lineTo(p.x, p.y)); ctx.lineTo(b.x, b.y); ctx.closePath();
