      for (const ex of [-4, 3]) { ctx.fillStyle = "#a8d46a"; ctx.beginPath(); ctx.arc(p.x + ex * s, p.y - 42 * s, 3 * s, 0, Math.PI * 2); ctx.fill(); ctx.stroke(); ctx.fillStyle = C.ink; ctx.beginPath(); ctx.arc(p.x + ex * s, p.y - 42 * s, 1.5 * s, 0, Math.PI * 2); ctx.fill(); }
      racket(p.x, p.y - 26 * s, s, op.side, op.swing, true, false);
    }
    function drawBall() {
      let x, y, z;
      if (ball) ({ x, y, z } = ball);
      else if (state === "serve" && serveMeter && server === 0) { const u = Math.min(1, (simNow - serveMeter.t0) / 0.5); x = me.x + 0.3; y = me.y + 0.3; z = 1.2 + 2.0 * Math.sin(u * Math.PI / 2); }
      else { trail.length = 0; return; }
      shadow(x, y, 5, Math.max(0.12, 0.38 - z * 0.05));
      const p = P(x, y, z), r = Math.max(3, 6.6 * p.s);
      trail.push([p.x, p.y, r]); if (trail.length > 8) trail.shift();
      trail.forEach(([tx, ty, tr], i) => { ctx.fillStyle = `rgba(227,242,74,${(i + 1) / trail.length * 0.28})`; ctx.beginPath(); ctx.arc(tx, ty, tr * (0.5 + i / trail.length * 0.5), 0, Math.PI * 2); ctx.fill(); });
      ctx.fillStyle = "#e3f24a"; ctx.strokeStyle = C.ink; ctx.lineWidth = 1.6; ctx.beginPath(); ctx.arc(p.x, p.y, r, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
