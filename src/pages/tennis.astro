      ctx.strokeStyle = "rgba(255,255,255,.16)"; ctx.lineWidth = 1;
      for (let i = 0; i <= 44; i++) { const x = L + (Rr - L) * i / 44, p1 = P(x, NET), p2 = P(x, NET, netH(x)); ctx.beginPath(); ctx.moveTo(p1.x, p1.y); ctx.lineTo(p2.x, p2.y); ctx.stroke(); }
      ctx.strokeStyle = C.line; ctx.lineWidth = 4; ctx.beginPath(); top.forEach((p, i) => i ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y)); ctx.stroke();
      ctx.strokeStyle = C.ink; ctx.lineWidth = 4;
      for (const x of [L, Rr]) { const p1 = P(x, NET), p2 = P(x, NET, 1.07); ctx.beginPath(); ctx.moveTo(p1.x, p1.y); ctx.lineTo(p2.x, p2.y - 3); ctx.stroke(); }
    }
    function shadow(x, y, r, a = 0.32) { const p = P(x, y); ctx.fillStyle = `rgba(60,20,8,${a})`; ctx.beginPath(); ctx.ellipse(p.x, p.y, r * p.s, r * 0.38 * p.s, 0, 0, Math.PI * 2); ctx.fill(); }
    function racket(cx, cy, s, side, swing, far, charging) {
      const ang = side * (0.6 - swing * 2.4 + (charging ? -0.9 : 0)) + (far ? Math.PI : 0);
      ctx.save(); ctx.translate(cx + side * 16 * s, cy - 6 * s); ctx.rotate(ang);
      ctx.strokeStyle = C.ink; ctx.lineWidth = 3 * s; ctx.beginPath(); ctx.moveTo(0, 0); ctx.lineTo(0, -14 * s); ctx.stroke();
      ctx.fillStyle = "rgba(255,250,232,.6)"; ctx.beginPath(); ctx.ellipse(0, -24 * s, 7 * s, 10 * s, 0, 0, Math.PI * 2); ctx.fill();
      ctx.lineWidth = 2.4 * s; ctx.stroke(); ctx.restore();
    }
    function drawHan(now) {
      shadow(me.x, me.y, 22);
      const p = P(me.x, me.y), s = p.s * 1.25, run = Math.min(1, Math.hypot(me.vx, me.vy) / 5), leg = Math.sin(now / 70) * 5 * run;
      ctx.lineWidth = 2.4 * s; ctx.strokeStyle = C.ink;
      ctx.beginPath(); ctx.moveTo(p.x - 6 * s, p.y); ctx.lineTo(p.x - 4 * s + leg * s * 0.3, p.y - 16 * s); ctx.moveTo(p.x + 6 * s, p.y); ctx.lineTo(p.x + 4 * s - leg * s * 0.3, p.y - 16 * s); ctx.stroke();
      ctx.fillStyle = "#f2e6cc"; ctx.fillRect(p.x - 8 * s, p.y - 20 * s, 16 * s, 6 * s);
      ctx.fillStyle = C.red; ctx.beginPath(); ctx.roundRect(p.x - 10 * s, p.y - 40 * s, 20 * s, 22 * s, 5 * s); ctx.fill(); ctx.stroke();
      ctx.fillStyle = "#f1c9a5"; ctx.beginPath(); ctx.arc(p.x, p.y - 48 * s, 9 * s, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
      ctx.fillStyle = C.ink; ctx.beginPath(); ctx.arc(p.x, p.y - 51 * s, 9 * s, Math.PI * 1.05, Math.PI * 1.95); ctx.fill();
      racket(p.x, p.y - 28 * s, s, me.side, me.swing, false, !!me.charge);
    }
    function drawFrog() {
      shadow(op.x, op.y, 24);
      const p = P(op.x, op.y), s = p.s * 1.55;
      ctx.lineWidth = 2 * s; ctx.strokeStyle = C.ink; ctx.fillStyle = "#efc23a";
      for (const k of [-1, 1]) { ctx.beginPath(); ctx.moveTo(p.x + k * 6 * s, p.y - 12 * s); ctx.lineTo(p.x + k * 13 * s, p.y - 4 * s); ctx.lineTo(p.x + k * 11 * s, p.y); ctx.lineTo(p.x + k * 4 * s, p.y - 8 * s); ctx.closePath(); ctx.fill(); ctx.stroke(); }
      ctx.beginPath(); ctx.moveTo(p.x - 4 * s, p.y - 44 * s);
      ctx.bezierCurveTo(p.x - 18 * s, p.y - 30 * s, p.x - 16 * s, p.y - 8 * s, p.x, p.y - 8 * s);
      ctx.bezierCurveTo(p.x + 16 * s, p.y - 8 * s, p.x + 18 * s, p.y - 30 * s, p.x + 6 * s, p.y - 44 * s);
