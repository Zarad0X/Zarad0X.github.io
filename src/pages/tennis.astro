---
import PageLayout from "@layouts/PageLayout.astro";
---
<PageLayout title="Clay Court" description="A tiny tennis game: Han vs 奶蛙 on clay. First to three games.">
  <div class="standalone-heading court-heading">
    <span class="kicker">Exhibition match</span>
    <h1>Clay Court</h1>
    <p>Han vs 奶蛙. First to three games. No line judges, no challenges.</p>
  </div>

  <div class="court-wrap" id="wrap">
    <canvas id="court" aria-label="Tennis game. Move with the mouse, a finger, or the arrow keys; tap or press Space to serve and for a power shot."></canvas>
    <div class="court-card" id="card">
      <p class="cc-kicker">Chapter 15–40</p>
      <h2 class="cc-title">Han <span>vs</span> 奶蛙</h2>
      <ul class="cc-how">
        <li><b>Move</b> mouse · drag · ← → ↑ ↓</li>
        <li><b>Hit</b> automatic: where the ball meets your racket sets the angle</li>
        <li><b>Power</b> tap / Space just before contact</li>
        <li><b>Serve</b> tap / Space</li>
      </ul>
      <button type="button" id="play" class="cc-play">Play ▸</button>
    </div>
  </div>
  <p class="court-note">Best on a phone held upright, or any window. Sound off, as nature intended.</p>

  <script is:inline>
  (() => {
    const canvas = document.getElementById("court"), ctx = canvas.getContext("2d");
    const card = document.getElementById("card"), playBtn = document.getElementById("play");
    const VW = 600, VH = 800;                                  // virtual canvas size
    const AUTO = /autoplay/.test(location.search);              // test harness: the player plays itself
    let scale = 1, dpr = 1;
    function resize() {
      const w = Math.min(canvas.parentElement.clientWidth, 560);
      dpr = Math.min(2, devicePixelRatio || 1); scale = w / VW;
      canvas.style.width = w + "px"; canvas.style.height = (w * VH / VW) + "px";
      canvas.width = Math.round(w * dpr); canvas.height = Math.round(w * VH / VW * dpr);
    }
    resize(); addEventListener("resize", resize);

    // ---------- court geometry: x ∈ [-1, 1] singles sidelines, y 0 = near baseline … 1 = far baseline, net at 0.5 ----------
    const NEAR_Y = 0.85 * VH, FAR_Y = 0.2 * VH, HALF_NEAR = 0.39 * VW, HALF_FAR = 0.27 * VW;
    const persp = t => t * 1.3 / (1 + 0.3 * t);
    function P(x, y, z = 0) {
      const ty = persp(y), s = 1 + (HALF_FAR / HALF_NEAR - 1) * ty;
      return { x: VW / 2 + x * HALF_NEAR * s, y: NEAR_Y + (FAR_Y - NEAR_Y) * ty - z * 300 * s, s };
    }
    function unproject(sx, sy, yHint) {                       // screen → court (for pointer control)
      let lo = -0.4, hi = 1.4;
      for (let i = 0; i < 30; i++) { const mid = (lo + hi) / 2; (P(0, mid).y > sy) ? (lo = mid) : (hi = mid); }
      const y = (lo + hi) / 2, s = P(0, y).s;
      return { x: (sx - VW / 2) / (HALF_NEAR * s), y };
    }
    const SERVICE_NEAR = 0.5 - 0.5 * 0.538, SERVICE_FAR = 0.5 + 0.5 * 0.538;

    // ---------- state ----------
    const names = ["HAN", "奶蛙"];
    let state = "title";                                        // title | serve | rally | point | over
    let games = [0, 0], pts = [0, 0], server = 0, pointNo = 0;
    let matchPointsSaved = 0, wasDown02 = false;
    const me = { x: 0.3, y: -0.06, tx: 0.3, ty: -0.06, swing: 0, side: 1, powerAt: -9 };
    const op = { x: -0.3, y: 1.06, tx: -0.3, ty: 1.06, swing: 0, side: 1, react: 0 };
    let ball = null, sub = null, subUntil = 0, toss = 0, cpuServeAt = 0, pointEndsAt = 0;
    const keys = new Set();
    let pointer = null;

    function say(who, text, ms = 1600) { sub = { who, text }; subUntil = performance.now() + ms; }

    function resetPositions() {
      const even = (pts[0] + pts[1]) % 2 === 0, dir = even ? 1 : -1;  // deuce court first
      if (server === 0) { me.x = me.tx = 0.32 * dir; me.y = me.ty = -0.08; op.x = op.tx = -0.42 * dir; op.y = op.ty = 1.08; }
      else { op.x = op.tx = -0.32 * dir; op.y = op.ty = 1.08; me.x = me.tx = 0.42 * dir; me.y = me.ty = -0.08; }
      ball = null; toss = 0;
      state = "serve";
      if (server === 1) cpuServeAt = performance.now() + 1100;
    }

    // a shot = straight line in x/y with a parabolic z, from (x0,y0,z0) to the bounce (xb,yb) in T seconds
    function shoot(hitter, x0, y0, z0, xb, yb, T, apex, kind) {
      ball = { hitter, x0, y0, z0, xb, yb, T, apex, t: 0, phase: 1, kind, x: x0, y: y0, z: z0, touched: false };
    }
    function zAt(t, T, z0, apex) {                              // parabola: z0 at 0, apex near middle, 0 at T
      const u = t / T; return (1 - u) * z0 + 4 * apex * u * (1 - u);
    }

    function pointTo(w, why) {
      if (state !== "rally" && state !== "serve") return;
      state = "point"; pointEndsAt = performance.now() + 1500;
      const l = 1 - w;
      // was the CPU on match point?
      const cpuMatchPoint = games[1] === 2 && pts[1] >= 3 && pts[1] > pts[0];
      if (cpuMatchPoint && w === 0) matchPointsSaved++;
      pts[w]++;
      let line = why;
      if (pts[w] >= 4 && pts[w] - pts[l] >= 2) {
        games[w]++; pts = [0, 0]; server = 1 - server;
        if (games[0] === 0 && games[1] === 2) wasDown02 = true;
        if (games[w] === 3) {
          state = "over"; pointEndsAt = performance.now() + 900;
          const comeback = w === 0 && wasDown02, saved = w === 0 && matchPointsSaved > 0;
          say("COMMENTATOR", w === 0
            ? (comeback && saved ? `From 0–2 down, ${matchPointsSaved} match point${matchPointsSaved > 1 ? "s" : ""} saved. Roland-Garros 2025 energy.`
              : comeback ? "From two games down. Pure Alcaraz." : saved ? "Match point saved — and the match. Unreal." : "Game, set and match, Han.")
            : "Game, set and match, 奶蛙. Horse stance wins again.", 4000);
          setTimeout(showEnd, 1600);
          return;
        }
        line = `Game, ${w === 0 ? "Han" : "奶蛙"}.`;
      } else if (pts[0] >= 3 && pts[1] >= 3) {
        line = pts[0] === pts[1] ? "Deuce." : `Advantage, ${pts[0] > pts[1] ? "Han" : "奶蛙"}.`;
        if (why && !/Deuce|Advantage/.test(why)) line = `${why} ${line}`;
      }
      if (line) say("COMMENTATOR", line, 1500);
    }

    function scoreText(i) {
      const a = pts[i], b = pts[1 - i];
      if (a >= 3 && b >= 3) return a === b ? "40" : a > b ? "AD" : "40";
      return ["0", "15", "30", "40"][Math.min(a, 3)];
    }

    // ---------- input ----------
    function toCanvas(e) { const r = canvas.getBoundingClientRect(); return { x: (e.clientX - r.left) / scale, y: (e.clientY - r.top) / scale }; }
    canvas.addEventListener("pointermove", e => { pointer = toCanvas(e); });
    canvas.addEventListener("pointerdown", e => { pointer = toCanvas(e); action(); canvas.setPointerCapture(e.pointerId); });
    canvas.addEventListener("pointerleave", () => { if (matchMedia("(hover: hover)").matches) pointer = null; });
    addEventListener("keydown", e => {
      if (state === "title") return;
      if (["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown", " "].includes(e.key)) e.preventDefault();
      if (e.key === " ") action(); else keys.add(e.key);
    });
    addEventListener("keyup", e => keys.delete(e.key));
    function action() {
      const now = performance.now();
      if (state === "serve" && server === 0 && !toss) { toss = now; return; }
      me.powerAt = now;
    }
    playBtn.addEventListener("click", start);
    function start() {
      games = [0, 0]; pts = [0, 0]; server = 0; matchPointsSaved = 0; wasDown02 = false;
      card.hidden = true; resetPositions();
      say("COMMENTATOR", "Han to serve. Tap or press Space.", 2200);
      canvas.focus({ preventScroll: true });
    }
    function showEnd() {
      card.hidden = false;
      card.querySelector(".cc-kicker").textContent = games[0] > games[1] ? "Final · Han wins" : "Final · 奶蛙 wins";
      card.querySelector(".cc-title").innerHTML = `${games[0]} <span>–</span> ${games[1]}`;
      playBtn.textContent = "Rematch ▸";
    }

    // ---------- simulation ----------
    const REACH_X = 0.26, REACH_Y = 0.1;
    function update(dt, now) {
      // player movement: pointer or keys, capped speed so you have to read the ball
      if (pointer && state !== "title") { const c = unproject(pointer.x, pointer.y); me.tx = c.x; me.ty = c.y; }
      const kx = (keys.has("ArrowRight") || keys.has("d") ? 1 : 0) - (keys.has("ArrowLeft") || keys.has("a") ? 1 : 0);
      const ky = (keys.has("ArrowUp") || keys.has("w") ? 1 : 0) - (keys.has("ArrowDown") || keys.has("s") ? 1 : 0);
      if (kx || ky) { me.tx = me.x + kx * 0.5; me.ty = me.y + ky * 0.5; pointer = null; }
      me.tx = Math.max(-1.3, Math.min(1.3, me.tx)); me.ty = Math.max(-0.22, Math.min(0.42, me.ty));
      if (AUTO && state !== "title") {
        if (state === "serve" && server === 0 && !toss) toss = now;
        if (ball && ball.hitter === 1 && !ball.dead) { const tgt = ball.phase === 1 ? ball.xb + (ball.xb - ball.x0) / (ball.yb - ball.y0 || -1) * (-0.04 - ball.yb) : ball.x; me.tx = tgt + (Math.random() - 0.5) * 0.3; me.ty = -0.04; }
        window.__tennis = { state, games: games.slice(), pts: pts.slice(), server };
      }
      if (state === "serve" && server === 0) { me.tx = me.x; me.ty = me.y; }
      step(me, dt, 1.7, 1.1);
      step(op, dt, 1.25 + 0.08 * (games[0] + games[1]), 0.9);
      me.swing = Math.max(0, me.swing - dt * 5); op.swing = Math.max(0, op.swing - dt * 5);

      if (state === "serve") {
        if (server === 0 && toss && now - toss > 380) {             // player serve
          const dir = (pts[0] + pts[1]) % 2 === 0 ? 1 : -1;
          me.swing = 1; me.side = dir > 0 ? -1 : 1;
          shoot(0, me.x, me.y, 0.32, -dir * (0.28 + Math.random() * 0.45), SERVICE_FAR - 0.03 - Math.random() * 0.2, 0.82, 0.12, "serve");
          state = "rally";
        }
        if (server === 1 && now > cpuServeAt) {                      // CPU serve
          const dir = (pts[0] + pts[1]) % 2 === 0 ? 1 : -1;
          op.swing = 1;
          if (Math.random() < 0.035) { say("COMMENTATOR", "Double fault.", 1300); pointTo(0, ""); return; }
          shoot(1, op.x, op.y, 0.32, dir * (0.25 + Math.random() * 0.5), SERVICE_NEAR + 0.03 + Math.random() * 0.18, 0.85, 0.12, "serve");
          state = "rally";
        }
      }

      if (ball && ball.net) {                                         // caught by the net: drop and roll back a little
        const n = ball.net; n.t += dt; ball.x = n.x; ball.y = n.y + (ball.hitter === 0 ? -1 : 1) * Math.min(0.03, n.t * 0.03);
        ball.z = Math.max(0, n.z - n.t * 0.5);
      } else if (ball && (state === "rally" || state === "point" || state === "over")) {
        ball.t += dt;
        if (ball.phase === 1) {
          const u = Math.min(1, ball.t / ball.T);
          ball.x = ball.x0 + (ball.xb - ball.x0) * u; ball.y = ball.y0 + (ball.yb - ball.y0) * u;
          ball.z = zAt(Math.min(ball.t, ball.T), ball.T, ball.z0, ball.apex);
          // net: crossing y = 0.5 too low
          const crossing = (ball.y0 - 0.5) * (ball.y - 0.5) <= 0 && !ball.netChecked;
          if (crossing) { ball.netChecked = true; if (ball.z < 0.07 && state === "rally") { ball.dead = true; ball.net = { x: ball.x, y: ball.hitter === 0 ? 0.485 : 0.515, z: ball.z, t: 0 }; pointTo(1 - ball.hitter, "Net."); } }
          if (ball.t >= ball.T) {                                      // first bounce
            ball.phase = 2; ball.t = 0; ball.bx = ball.xb; ball.by = ball.yb;
            const vx = (ball.xb - ball.x0) / ball.T, vy = (ball.yb - ball.y0) / ball.T;
            ball.vx = vx * 0.78; ball.vy = vy * 0.78; ball.T2 = ball.T * 0.62; ball.apex2 = Math.max(0.07, ball.apex * 0.55);
            const otherHalf = ball.hitter === 0 ? (ball.yb >= 0.5 && ball.yb <= 1) : (ball.yb >= 0 && ball.yb <= 0.5);
            let inBox = Math.abs(ball.xb) <= 1 && otherHalf;
            if (ball.kind === "serve") inBox = inBox && (ball.hitter === 0 ? ball.yb <= SERVICE_FAR : ball.yb >= SERVICE_NEAR);
            if (!inBox && state === "rally") { ball.dead = true; pointTo(1 - ball.hitter, "Out."); }
          }
        } else {
          ball.x = ball.bx + ball.vx * ball.t; ball.y = ball.by + ball.vy * ball.t;
          const tt = ball.t % ball.T2, bounces = Math.floor(ball.t / ball.T2);
          ball.z = 4 * ball.apex2 * Math.pow(0.45, bounces) * (tt / ball.T2) * (1 - tt / ball.T2);
          if (state === "rally" && !ball.dead) {
            const receiver = ball.hitter === 0 ? op : me;
            if (bounces >= 1 || ball.y < -0.32 || ball.y > 1.32 || Math.abs(ball.x) > 1.6) {
              ball.dead = true;
              pointTo(ball.hitter, ball.kind === "serve" && !ball.touched ? "Ace." : (ball.hitter === 0 ? "Winner." : ""));
            } else if (Math.abs(ball.x - receiver.x) < REACH_X && Math.abs(ball.y - receiver.y) < REACH_Y && ball.z < 0.5) {
              hit(receiver === me ? 0 : 1, now);
            }
          }
        }
      }

      // CPU positioning: read the ball, a beat late
      if (ball && state === "rally" && ball.hitter === 0 && !ball.dead) {
        if (!op.react) op.react = now + 170;
        if (now > op.react) {
          let px, py;
          if (ball.phase === 1) {
            const dx = (ball.xb - ball.x0) / (ball.yb - ball.y0 || 1);
            py = Math.min(1.08, Math.max(0.82, ball.yb + 0.22)); px = ball.xb + dx * (py - ball.yb);
          } else { py = Math.min(1.08, Math.max(0.8, ball.y + 0.08)); px = ball.x + (ball.vx / (ball.vy || 1)) * (py - ball.y); }
          op.tx = px + (op.x < px ? -0.12 : 0.12); op.ty = py;
        }
      } else if (state === "rally" && ball && ball.hitter === 1) { op.react = 0; op.tx = op.x * 0.6; op.ty = 1.04; }

      if ((state === "point") && now > pointEndsAt) resetPositions();
    }

    function step(p, dt, vmaxX, vmaxY) {
      const dx = p.tx - p.x, dy = p.ty - p.y;
      p.x += Math.max(-vmaxX * dt, Math.min(vmaxX * dt, dx));
      p.y += Math.max(-vmaxY * dt, Math.min(vmaxY * dt, dy));
    }

    function hit(who, now) {
      const p = who === 0 ? me : op;
      ball.touched = true;
      const offset = Math.max(-1.2, Math.min(1.2, (ball.x - p.x) / REACH_X));   // −1 = ball on your left, +1 = right
      p.swing = 1; p.side = offset >= 0 ? 1 : -1;
      if (who === 0) {
        const power = now - me.powerAt < 360;
        const xb = -offset * 0.98 + (Math.random() - 0.5) * 0.12;
        const yb = power ? 0.84 + Math.random() * 0.2 : 0.66 + Math.random() * 0.26;
        shoot(0, ball.x, ball.y, Math.max(0.08, ball.z), xb, yb, power ? 0.72 : 1.0, power ? 0.12 : 0.2, power ? "power" : "rally");
        if (power) say("", "POWER.", 600);
      } else {
        const r = Math.random(), lvl = 0.02 * (games[0] + games[1]);
        let xb = (me.x > 0 ? -1 : 1) * (0.25 + Math.random() * 0.6), yb = 0.04 + Math.random() * 0.3, apex = 0.2, T = 1.0 - lvl * 2;
        if (r < 0.06 - lvl) { xb = (Math.random() < 0.5 ? -1 : 1) * (1.05 + Math.random() * 0.2); }      // wide
        else if (r < 0.1 - lvl) { yb = -0.04 - Math.random() * 0.08; }                                    // long
        else if (r < 0.14 - lvl) { apex = 0.03; yb = 0.45; }                                              // into the net
        shoot(1, ball.x, ball.y, Math.max(0.08, ball.z), xb, yb, T, apex, "rally");
      }
    }

    // ---------- drawing ----------
    const C = { paper: "#efd8a4", surround: "#a9471f", clay: "#c4622d", clayDark: "#b5552a", line: "#fff6e6", ink: "#141010", red: "#d3241c", yellow: "#f6c400" };
    function quad(a, b, c, d, fill) { ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.lineTo(c.x, c.y); ctx.lineTo(d.x, d.y); ctx.closePath(); ctx.fillStyle = fill; ctx.fill(); }
    function seg(x1, y1, x2, y2, w = 3) { const a = P(x1, y1), b = P(x2, y2); ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.lineWidth = w * a.s; ctx.stroke(); }

    function drawCourt() {
      // stands and back wall
      ctx.fillStyle = C.surround; ctx.fillRect(0, 0, VW, VH);
      ctx.fillStyle = "#1b2a1f"; ctx.fillRect(0, 0, VW, FAR_Y - 40);
      for (let i = 0; i < 26; i++) { ctx.fillStyle = i % 2 ? "#22362a" : "#1e3025"; ctx.fillRect(i * VW / 26, 18, VW / 26, FAR_Y - 70); }
      ctx.fillStyle = "#0e1a12"; ctx.fillRect(0, FAR_Y - 54, VW, 16);
      ctx.fillStyle = C.yellow; ctx.font = "16px 'Anton', Impact, sans-serif"; ctx.textAlign = "center"; ctx.textBaseline = "middle";
      ctx.fillText("C O U R T   P H I L I P P E - Z H A N G", VW / 2, FAR_Y - 46);
      // surround
      quad(P(-1.75, -0.45), P(1.75, -0.45), P(1.6, 1.38), P(-1.6, 1.38), C.surround);
      ctx.fillStyle = C.surround; ctx.fillRect(0, FAR_Y - 38, VW, 30);
      // court with brushed clay stripes
      for (let i = 0; i < 12; i++) {
        const y0 = i / 12, y1 = (i + 1) / 12;
        quad(P(-1.22, y0), P(1.22, y0), P(1.22, y1), P(-1.22, y1), i % 2 ? C.clay : C.clayDark);
      }
      // floodlight falloff: brighter near, dimmer far; soft vignette at the sides
      const g = ctx.createLinearGradient(0, FAR_Y - 40, 0, VH);
      g.addColorStop(0, "rgba(40,10,0,.34)"); g.addColorStop(.45, "rgba(40,10,0,.06)"); g.addColorStop(1, "rgba(255,230,190,.10)");
      ctx.fillStyle = g; ctx.fillRect(0, FAR_Y - 40, VW, VH);
      const v = ctx.createRadialGradient(VW / 2, VH * 0.6, VW * 0.25, VW / 2, VH * 0.6, VW * 0.85);
      v.addColorStop(0, "rgba(0,0,0,0)"); v.addColorStop(1, "rgba(30,6,0,.35)"); ctx.fillStyle = v; ctx.fillRect(0, 0, VW, VH);
      // lines, with a faint shadow so they sit on the clay
      ctx.lineCap = "round";
      ctx.save(); ctx.translate(1.5, 2); ctx.strokeStyle = "rgba(60,15,0,.35)"; courtLines(); ctx.restore();
      ctx.strokeStyle = C.line; courtLines();
    }
    function courtLines() {
      seg(-1.22, 0, 1.22, 0, 4); seg(-1.22, 1, 1.22, 1, 4);              // baselines
      seg(-1.22, 0, -1.22, 1); seg(1.22, 0, 1.22, 1);                     // doubles sidelines
      seg(-1, 0, -1, 1); seg(1, 0, 1, 1);                                 // singles sidelines
      seg(-1, SERVICE_NEAR, 1, SERVICE_NEAR); seg(-1, SERVICE_FAR, 1, SERVICE_FAR);
      seg(0, SERVICE_NEAR, 0, SERVICE_FAR); seg(0, -0.02, 0, 0.02); seg(0, 0.98, 0, 1.02);
    }
    function drawNet() {
      const a = P(-1.38, 0.5), b = P(1.38, 0.5), h = 0.095;
      const at = P(-1.38, 0.5, h), bt = P(1.38, 0.5, h);
      ctx.fillStyle = "rgba(20,16,16,.18)"; quad(P(-1.38, 0.5), P(1.38, 0.5), P(1.38, 0.535), P(-1.38, 0.535), "rgba(20,16,16,.16)");
      ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.lineTo(bt.x, bt.y); ctx.lineTo(at.x, at.y); ctx.closePath();
      ctx.fillStyle = "rgba(20,16,16,.55)"; ctx.fill();
      ctx.strokeStyle = "rgba(255,255,255,.18)"; ctx.lineWidth = 1;
      for (let i = 0; i <= 40; i++) { const x = -1.38 + i * 2.76 / 40, p1 = P(x, 0.5), p2 = P(x, 0.5, h); ctx.beginPath(); ctx.moveTo(p1.x, p1.y); ctx.lineTo(p2.x, p2.y); ctx.stroke(); }
      ctx.strokeStyle = C.line; ctx.lineWidth = 4; ctx.beginPath(); ctx.moveTo(at.x, at.y); ctx.lineTo(bt.x, bt.y); ctx.stroke();
      ctx.strokeStyle = C.ink; ctx.lineWidth = 4;
      for (const p of [[a, at], [b, bt]]) { ctx.beginPath(); ctx.moveTo(p[0].x, p[0].y); ctx.lineTo(p[1].x, p[1].y - 4); ctx.stroke(); }
    }
    function shadow(x, y, r) { const p = P(x, y); ctx.fillStyle = "rgba(60,20,8,.32)"; ctx.beginPath(); ctx.ellipse(p.x, p.y, r * p.s, r * 0.38 * p.s, 0, 0, Math.PI * 2); ctx.fill(); }
    function racket(cx, cy, s, side, swing, far) {
      const ang = side * (0.6 - swing * 2.2) + (far ? Math.PI : 0);
      ctx.save(); ctx.translate(cx + side * 16 * s, cy - 6 * s); ctx.rotate(ang);
      ctx.strokeStyle = C.ink; ctx.lineWidth = 3 * s; ctx.beginPath(); ctx.moveTo(0, 0); ctx.lineTo(0, -14 * s); ctx.stroke();
      ctx.fillStyle = "rgba(255,250,232,.6)"; ctx.beginPath(); ctx.ellipse(0, -24 * s, 7 * s, 10 * s, 0, 0, Math.PI * 2); ctx.fill();
      ctx.lineWidth = 2.4 * s; ctx.stroke(); ctx.restore();
    }
    function drawHan() {
      shadow(me.x, me.y, 20);
      const p = P(me.x, me.y), s = p.s * 1.25;
      ctx.lineWidth = 2.4 * s; ctx.strokeStyle = C.ink;
      ctx.beginPath(); ctx.moveTo(p.x - 6 * s, p.y); ctx.lineTo(p.x - 4 * s, p.y - 16 * s); ctx.moveTo(p.x + 6 * s, p.y); ctx.lineTo(p.x + 4 * s, p.y - 16 * s); ctx.stroke();
      ctx.fillStyle = "#f2e6cc"; ctx.fillRect(p.x - 8 * s, p.y - 20 * s, 16 * s, 6 * s);              // shorts
      ctx.fillStyle = C.red; ctx.beginPath(); ctx.roundRect(p.x - 10 * s, p.y - 40 * s, 20 * s, 22 * s, 5 * s); ctx.fill(); ctx.stroke();
      ctx.fillStyle = "#f1c9a5"; ctx.beginPath(); ctx.arc(p.x, p.y - 48 * s, 9 * s, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
      ctx.fillStyle = C.ink; ctx.beginPath(); ctx.arc(p.x, p.y - 51 * s, 9 * s, Math.PI * 1.05, Math.PI * 1.95); ctx.fill();
      racket(p.x, p.y - 28 * s, s, me.side, me.swing, false);
    }
    function drawFrog() {
      shadow(op.x, op.y, 24);
      const p = P(op.x, op.y), s = p.s * 1.55;
      ctx.lineWidth = 2 * s; ctx.strokeStyle = C.ink;
      // horse-stance legs
      ctx.fillStyle = "#efc23a";
      ctx.beginPath(); ctx.moveTo(p.x - 6 * s, p.y - 12 * s); ctx.lineTo(p.x - 13 * s, p.y - 4 * s); ctx.lineTo(p.x - 11 * s, p.y); ctx.lineTo(p.x - 4 * s, p.y - 8 * s); ctx.closePath(); ctx.fill(); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(p.x + 6 * s, p.y - 12 * s); ctx.lineTo(p.x + 13 * s, p.y - 4 * s); ctx.lineTo(p.x + 11 * s, p.y); ctx.lineTo(p.x + 4 * s, p.y - 8 * s); ctx.closePath(); ctx.fill(); ctx.stroke();
      // pear body + belly
      ctx.beginPath(); ctx.moveTo(p.x - 4 * s, p.y - 44 * s);
      ctx.bezierCurveTo(p.x - 18 * s, p.y - 30 * s, p.x - 16 * s, p.y - 8 * s, p.x, p.y - 8 * s);
      ctx.bezierCurveTo(p.x + 16 * s, p.y - 8 * s, p.x + 18 * s, p.y - 30 * s, p.x + 6 * s, p.y - 44 * s);
      ctx.quadraticCurveTo(p.x + 1 * s, p.y - 50 * s, p.x - 4 * s, p.y - 44 * s); ctx.fill(); ctx.stroke();
      ctx.fillStyle = "#f4dfbd"; ctx.beginPath(); ctx.ellipse(p.x - 1 * s, p.y - 20 * s, 9 * s, 8 * s, 0, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = "#a8d46a";
      for (const ex of [-4, 3]) { ctx.beginPath(); ctx.arc(p.x + ex * s, p.y - 42 * s, 3 * s, 0, Math.PI * 2); ctx.fill(); ctx.stroke(); ctx.fillStyle = C.ink; ctx.beginPath(); ctx.arc(p.x + ex * s, p.y - 42 * s, 1.5 * s, 0, Math.PI * 2); ctx.fill(); ctx.fillStyle = "#a8d46a"; }
      racket(p.x, p.y - 26 * s, s, op.side, op.swing, true);
    }
    const trail = [];
    function drawReach(now) {
      if (!(ball && ball.hitter === 1 && !ball.dead && state === "rally")) return;
      const p = P(me.x, me.y), a = 0.35 + 0.2 * Math.sin(now / 120);
      ctx.save(); ctx.strokeStyle = `rgba(246,196,0,${a})`; ctx.lineWidth = 2; ctx.setLineDash([6, 5]);
      ctx.beginPath(); ctx.ellipse(p.x, p.y, REACH_X * HALF_NEAR * p.s, REACH_Y * 300 * p.s * 0.55, 0, 0, Math.PI * 2); ctx.stroke(); ctx.restore();
    }
    function drawBall() {
      if (!ball && !(state === "serve" && toss)) { trail.length = 0; return; }
      let x, y, z;
      if (ball) { x = ball.x; y = ball.y; z = ball.z; }
      else { const u = Math.min(1, (performance.now() - toss) / 380); x = me.x; y = me.y; z = 0.15 + 0.35 * Math.sin(u * Math.PI); }
      shadow(x, y, 5);
      const p = P(x, y, z), r = 6.2 * p.s;
      trail.push([p.x, p.y, r]); if (trail.length > 7) trail.shift();
      trail.forEach(([tx, ty, tr], i) => { ctx.fillStyle = `rgba(227,242,74,${(i + 1) / trail.length * 0.28})`; ctx.beginPath(); ctx.arc(tx, ty, tr * (0.5 + i / trail.length * 0.5), 0, Math.PI * 2); ctx.fill(); });
      ctx.fillStyle = "#e3f24a"; ctx.strokeStyle = C.ink; ctx.lineWidth = 1.6;
      ctx.beginPath(); ctx.arc(p.x, p.y, r, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
      ctx.strokeStyle = "rgba(255,255,255,.8)"; ctx.lineWidth = 1; ctx.beginPath(); ctx.arc(p.x - r * 0.9, p.y, r * 0.8, -0.9, 0.9); ctx.stroke();
    }
    function drawScore() {
      const x = 16, y = 16, rowH = 30, w = 186;
      ctx.save();
      ctx.fillStyle = C.red; ctx.fillRect(x + 4, y + 4, w, rowH * 2);
      ctx.fillStyle = "#0b0908"; ctx.fillRect(x, y, w, rowH * 2);
      ctx.font = "700 17px 'Anton', Impact, sans-serif"; ctx.textBaseline = "middle";
      for (let i = 0; i < 2; i++) {
        const ry = y + rowH * i + rowH / 2;
        ctx.textAlign = "left"; ctx.fillStyle = "#f2e6cc";
        ctx.fillText(names[i], x + 22, ry);
        if (server === i && state !== "over") { ctx.fillStyle = C.yellow; ctx.beginPath(); ctx.arc(x + 10, ry, 4, 0, Math.PI * 2); ctx.fill(); }
        ctx.textAlign = "center"; ctx.fillStyle = "#f2e6cc"; ctx.fillText(games[i], x + 120, ry);
        ctx.fillStyle = C.yellow; ctx.fillRect(x + 140, y + rowH * i + 3, 42, rowH - 6);
        ctx.fillStyle = "#0b0908"; ctx.fillText(state === "over" ? "" : scoreText(i), x + 161, ry + 1);
      }
      ctx.restore();
    }
    function drawSub(now) {
      if (!sub || now > subUntil) return;
      ctx.save(); ctx.font = "700 18px 'Courier Prime', monospace"; ctx.textAlign = "center"; ctx.textBaseline = "middle";
      const text = (sub.who ? `[${sub.who}] ` : "") + sub.text;
      const lines = []; let cur = "";
      for (const word of text.split(" ")) { const t = cur ? cur + " " + word : word; if (ctx.measureText(t).width > VW - 80) { lines.push(cur); cur = word; } else cur = t; }
      lines.push(cur);
      const h = lines.length * 26 + 14, top = VH - 30 - h;
      ctx.fillStyle = "rgba(0,0,0,.78)"; ctx.fillRect(28, top, VW - 56, h);
      lines.forEach((l, i) => { ctx.fillStyle = C.yellow; ctx.fillText(l, VW / 2, top + 20 + i * 26); });
      ctx.restore();
    }
    function drawPrompt(now) {
      if (state === "serve" && server === 0 && !toss) {
        const p = P(me.x, me.y), a = 0.55 + 0.45 * Math.sin(now / 220);
        ctx.save(); ctx.globalAlpha = a; ctx.fillStyle = C.ink; ctx.font = "700 13px 'Courier Prime', monospace"; ctx.textAlign = "center";
        ctx.fillText("TAP / SPACE TO SERVE", p.x, p.y + 30); ctx.restore();
      }
    }

    let last = performance.now();
    function frame(now) {
      const dt = Math.min(0.033, (now - last) / 1000); last = now;
      if (state !== "title") update(dt, now);
      ctx.setTransform(scale * dpr, 0, 0, scale * dpr, 0, 0);
      ctx.fillStyle = C.paper; ctx.fillRect(0, 0, VW, VH);
      drawCourt();
      // depth sort: far player, net, near player; ball by depth
      const ballFar = ball ? ball.y > 0.5 : false;
      drawFrog();
      if (ball && ballFar) drawBall();
      drawNet();
      if (!ball || !ballFar) drawBall();
      drawReach(now);
      drawHan();
      drawScore(); drawPrompt(now); drawSub(now);
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
    document.addEventListener("visibilitychange", () => { last = performance.now(); });
  })();
  </script>
</PageLayout>

