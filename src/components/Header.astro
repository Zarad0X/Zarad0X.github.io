---
const home = Astro.url.pathname === "/";
const path = Astro.url.pathname;
const active = path.startsWith("/blog") ? "blog" : path.startsWith("/work") ? "experience" : path.startsWith("/projects") ? "research" : "";
---
<header class="header">
  <a class="wordmark" href="/" aria-label="Han Zhang home">hz<span>.</span></a>
  <nav aria-label="Main navigation">
    <a href={home ? "#research" : "/#research"} aria-current={active === "research" ? "page" : undefined}>Research</a>
    <a href={home ? "#experience" : "/#experience"} aria-current={active === "experience" ? "page" : undefined}>Experience</a>
    <a href={home ? "#blog" : "/blog/"} aria-current={active === "blog" ? "page" : undefined}>Blog</a>
  </nav>
</header>
