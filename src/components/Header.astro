---
const path = Astro.url.pathname;
const active = path.startsWith("/shelf") ? "shelf" : path.startsWith("/blog") ? "blog" : path.startsWith("/work") ? "experience" : path.startsWith("/projects") ? "research" : "";
---
<header class="header">
  <a class="wordmark" href="/" aria-label="Han Zhang home"><span aria-hidden="true"><span class="nl" style="--k:0">H</span><span class="nl" style="--k:1">a</span><span class="nl" style="--k:2">n</span> <span class="nl" style="--k:4">Z</span><span class="nl" style="--k:5">h</span><span class="nl" style="--k:6">a</span><span class="nl" style="--k:7">n</span><span class="nl flick" style="--k:8">g</span></span></a>
  <nav aria-label="Main navigation">
    <a href="/#magician" aria-current={active === "research" ? "page" : undefined}>Research</a>
    <a href="/#wheel" aria-current={active === "experience" ? "page" : undefined}>Journey</a>
    <a href="/blog/" aria-current={active === "blog" ? "page" : undefined}>Blog</a>
    <a href="/shelf/" aria-current={active === "shelf" ? "page" : undefined}>Shelf</a>
    <button class="theme-toggle" type="button" id="themeToggle">☾ Grindhouse</button>
  </nav>
</header>
<script is:inline>
(() => {
  const btn = document.getElementById("themeToggle"), root = document.documentElement;
  const label = () => { const n = root.classList.contains("night"); btn.textContent = n ? "☀ Pulp" : "☾ Grindhouse"; btn.setAttribute("aria-pressed", n); };
  label();
  btn.addEventListener("click", () => { const n = root.classList.toggle("night"); try { localStorage.setItem("hz-theme-t", n ? "night" : "paper"); } catch (e) {} label(); });
})();
</script>
