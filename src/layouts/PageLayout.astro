---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@consts";
interface Props {
  title: string;
  description: string;
  reading?: boolean;
  lang?: "en" | "zh";
  type?: "website" | "article";
  image?: string;
}
const { title, description, reading = false, lang = "en", type = "website", image } = Astro.props;
const pageTitle = title.includes(SITE.NAME) ? title : `${title} | ${SITE.NAME}`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <Head title={pageTitle} description={description} lang={lang} type={type} image={image} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&family=Courier+Prime:ital,wght@0,400;0,700;1,400&display=swap" />
    <link rel="stylesheet" href="/pulp.css" />
    <script is:inline>try{if(localStorage.getItem("hz-theme-t")==="night")document.documentElement.classList.add("night")}catch(e){}</script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class:list={["page", { "reading-page": reading }]}>
      <Header />
      <main id="main"><slot /></main>
      <Footer />
    </div>
  </body>
</html>
