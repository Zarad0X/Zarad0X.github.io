---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@consts";
interface Props {
  title: string;
  description: string;
  reading?: boolean;
  lang?: "en" | "zh";
  type?: "website" | "article";
  image?: string;
}
const { title, description, reading = false, lang = "en", type = "website", image } = Astro.props;
const pageTitle = title.includes(SITE.NAME) ? title : `${title} | ${SITE.NAME}`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <Head title={pageTitle} description={description} lang={lang} type={type} image={image} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class:list={["page", { "reading-page": reading }]}>
      <Header />
      <main id="main"><slot /></main>
      <Footer />
    </div>
  </body>
</html>
